PvNP.RealizableHardness.ActualStarExtensionProduct.eventMass_uniform_filter_function.{u_2} (Ω : Type u_2) [Fintype Ω]
  [Nonempty Ω] (P : Ω → Prop) [DecidablePred P] :
  ActualFiniteLaw.eventMass (ActualFiniteLaw.uniformLaw Ω) (Finset.filter P Finset.univ) =
    ↑(Finset.filter P Finset.univ).card / ↑(Fintype.card Ω)
PvNP.RealizableHardness.ActualStarExtensionProduct.uniformFunction_cylinder_eventMass.{u_2, u_3} {I : Type u_2}
  {Ω : Type u_3} [Fintype I] [DecidableEq I] [Fintype Ω] [Nonempty Ω] (P : I → Ω → Prop) [(i : I) → DecidablePred (P i)]
  [DecidablePred fun x => ∀ (i : I), P i (x i)] :
  ActualFiniteLaw.eventMass (ActualFiniteLaw.uniformLaw (I → Ω)) {x | ∀ (i : I), P i (x i)} =
    ∏ i, ActualFiniteLaw.eventMass (ActualFiniteLaw.uniformLaw Ω) (Finset.filter (P i) Finset.univ)
