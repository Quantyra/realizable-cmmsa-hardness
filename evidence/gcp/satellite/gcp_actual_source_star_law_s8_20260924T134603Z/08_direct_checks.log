PvNP.RealizableHardness.ActualSourceStarLaw.acceptanceMass.{u_1} {V : Type u_1} [AddCommGroup V] [Module (ZMod 2) V]
  [Finite V] {t d : ℕ} (htd : t ≤ d) (hdV : d ≤ Module.finrank (ZMod 2) V) (m : ℕ)
  (Tcenter : ActualSourceStarLaw.CenterTable t) (Tleaf : ActualSourceStarLaw.LeafTable d) : ℚ
PvNP.RealizableHardness.ActualSourceStarLaw.goodStarMass_eq_joint_sum.{u_1} {V : Type u_1} [AddCommGroup V]
  [Module (ZMod 2) V] [Finite V] {t d m : ℕ} (htd : t ≤ d) (hdV : d ≤ Module.finrank (ZMod 2) V)
  (Tcenter : ActualSourceStarLaw.CenterTable t) (Tleaf : ActualSourceStarLaw.LeafTable d) :
  ActualSourceStarLaw.goodStarMass htd hdV m Tcenter Tleaf =
    ∑ z with (ActualSourceStarLaw.goodStar Tcenter Tleaf) z,
      (ActualSourceStarLaw.centerLaw z.fst).mass z.fst *
        ∏ i, (ActualSourceStarLaw.extensionLaw z.fst (z.snd i)).mass (z.snd i)
