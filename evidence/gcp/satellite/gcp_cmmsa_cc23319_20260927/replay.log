        ∀ (i : Fin 2),
          ActualPresentedLeafGluing.restrictToCenter (drawnCenterSub q z.fst ↑(z.snd i) ⋯)
              (selectedTable T s (vertexOfGrass q ↑(z.snd i))) =
            g z}
