  {N nRows J t h : ℕ} {I : Instance N nRows} (T : ActualCliqueCollisionTransfer.LeafTable I J h)
  (s : RepresentativeChoice I J h) (q : QuestionCenter I J t) (htd : t ≤ 2 * h)
  (hdV : 2 * h ≤ Module.finrank (ZMod 2) ↥(transverseComplement q))
  (g : (z : StarTuple t (2 * h) 2) → ↥(complementToAmbient q ↑z.fst) →ₗ[ZMod 2] ZMod 2) :
  eventMass (classRepLaw h q htd hdV) {p | representativeAccepts (selectedTable T s) q p (g p.fst)} =
    eventMass (starLaw htd hdV)
