  (S : Finset (Fin m)) (hS : 2 ≤ S.card) (v : ↥S → V ⧸ ↑z.fst) (hnz : ∀ (i : ↥S), v i ≠ 0)
  (hincrement : ∀ (i : ↥S), v i ∈ ActualStarJointKernel.incrementFamily z ↑i) (hsum : ∑ i, v i = 0) :
