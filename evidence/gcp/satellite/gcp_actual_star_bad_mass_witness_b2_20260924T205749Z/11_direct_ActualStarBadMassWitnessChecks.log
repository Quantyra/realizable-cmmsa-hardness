PvNP.RealizableHardness.ActualStarBadMassWitness.fixedCenter_relationLineEvent_mass.{u_1} {V : Type u_1}
  [AddCommGroup V] [Module (ZMod 2) V] [Finite V] {t d m : ℕ} (htd : t ≤ d) (hdV : d ≤ Module.finrank (ZMod 2) V)
  (hk : 1 ≤ d - t) (U : GrassmannCounting.Grass V t) (witness : Fin m → ActualSourceStarLaw.Extension U d)
  (S : Finset (Fin m)) (v : ↥S → V ⧸ ↑U) (hnz : ∀ (i : ↥S), v i ≠ 0) (hsum : ∑ i, v i = 0) :
  ActualFiniteLaw.eventMass (ActualStarExtensionProduct.extensionTupleLaw U witness)
      (ActualStarExtensionProduct.supportedLineEvent htd S U fun i =>
        ActualStarBadMassWitness.quotientVectorLine (v i) ⋯) =
    (↑(GrassmannCounting.gaussian (d - t) 1) / ↑(GrassmannCounting.gaussian (Module.finrank (ZMod 2) (V ⧸ ↑U)) 1)) ^
      S.card
PvNP.RealizableHardness.ActualStarKernelSupport.kernelWitness_has_exact_support_relation.{u_1} {V : Type u_1}
