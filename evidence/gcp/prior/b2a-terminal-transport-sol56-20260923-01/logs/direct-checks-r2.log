PvNP.RealizableHardness.ActualMZ24TerminalAgreementTransport.agreement_le_complement.{u_1} {V : Type u_1}
  [AddCommGroup V] [Module (ZMod 2) V] [Fintype V] {a d : ℕ} (E : Submodule (ZMod 2) V) (Q : Grass V a)
  (T : (L : Grass V d) → Module.Dual (ZMod 2) ↥↑L) (P : DecodedPair Q d) (hQE : ↑Q ≤ E) (hWE : P.W ≤ E)
  (C : AdviceComplement (localGrass E Q hQE)) (had : a ≤ d) (hb : a + (d - a) = d) :
  agreement T Q P ≤
    agreement (complementTable (restrictedTable E T) C had hb) (bottomGrass C.A)
      (complementPair C (localDecodedPair E Q P hQE hWE))
