PvNP.RealizableHardness.ActualMZ24TerminalAgreementTransport.uniformLaw_zoomRestriction.{u_1} {V : Type u_1}
  [AddCommGroup V] [Module (ZMod 2) V] [Fintype V] {a d : ℕ} (E : Submodule (ZMod 2) V) (Q : Grass V a)
  (P : DecodedPair Q d) (hQE : ↑Q ≤ E) (hWE : P.W ≤ E) [Nonempty (Zoom Q P)] :
  pushforward (⇑(zoomRestrictionEquiv E Q P hQE hWE)) (uniformLaw (Zoom Q P)) =
