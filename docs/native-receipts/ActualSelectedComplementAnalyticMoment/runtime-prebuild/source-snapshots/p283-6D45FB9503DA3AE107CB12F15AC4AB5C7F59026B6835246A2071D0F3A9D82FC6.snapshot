import PvNP.RealizableHardness.ActualTypedABFullA16Assembly
import PvNP.RealizableHardness.ActualBinaryMatrixHC46TypedFourierTransport
import PvNP.RealizableHardness.BinaryMatrixNestedSelectorA1
import PvNP.RealizableHardness.BinaryMatrixA1Complex
import PvNP.RealizableHardness.BinaryMatrixComplexA14

/-! Rank bookkeeping for the actual A18 affine derivative carrier. The
selected ambient frequencies have a fixed rank cost, and their induced
carrier frequency retains the residual rank. -/

namespace PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection

open PvNP.RealizableHardness.BinaryMatrixA1Complex
open PvNP.RealizableHardness.BinaryMatrixNestedSelectorA1
open PvNP.RealizableHardness.ActualBinaryMatrixHC46TypedFourierTransport
open PvNP.RealizableHardness.BinaryMatrixTypedA15Transport
open PvNP.RealizableHardness.BinaryMatrixComplexA14
open PvNP.RealizableHardness.BinaryMatrixFourier
open PvNP.RealizableHardness.BinaryMatrixTypedA14Line
open PvNP.RealizableHardness.ActualTypedABProjectionEnergy
open PvNP.RealizableHardness.ActualTypedABCanonicalDCollapse
open PvNP.RealizableHardness.ActualTypedABFullA16Assembly

noncomputable section
set_option autoImplicit false

private abbrev F := ZMod 2
private abbrev V (d : Nat) := Fin d → F
private abbrev W (n : Nat) := Fin n → F

private def selectedCarrierFrequency {n d : Nat}
    (A : Submodule F (V d)) (B : Submodule F (W n))
    (Y : BinaryMatrix n d) : B →ₗ[F] (V d ⧸ A) :=
  (A.mkQ).comp ((Y.transpose.toLin').domRestrict B)

/-- On a selected ambient frequency, rank splits into the fixed carrier
cost plus the rank of its induced carrier frequency. -/
theorem selected_frequency_rank_eq_carrier_rank_add_cost
    {n d : Nat} (A : Submodule F (V d)) (B : Submodule F (W n))
    (Y : BinaryMatrix n d)
    (hsel : Selected A B Y.transpose.toLin') :
    Y.rank = Module.finrank F A + Module.finrank F (W n ⧸ B) +
      Module.finrank F (LinearMap.range (selectedCarrierFrequency A B Y)) := by
  classical
  let L : W n →ₗ[F] V d := Y.transpose.toLin'
  let qL : W n →ₗ[F] (V d ⧸ A) := A.mkQ.comp L
  let R : Submodule F (V d) := LinearMap.range L
  let AR : Submodule F R := A.comap R.subtype
  let qR : R →ₗ[F] (V d ⧸ A) := A.mkQ.comp R.subtype
  let qB : B →ₗ[F] (V d ⧸ A) := qL.domRestrict B
  have hAR : A ≤ R := hsel.1
  have hARdim : Module.finrank F AR = Module.finrank F A := by
    exact (Submodule.comapSubtypeEquivOfLe hAR).finrank_eq
  have hkerR : LinearMap.ker qR = AR := by
    simp [qR, AR, LinearMap.ker_comp]
  have hfactor : qL = qR.comp L.rangeRestrict := by
    ext x
    rfl
  have hqrange : LinearMap.range qL = LinearMap.range qR := by
    rw [hfactor]
    exact LinearMap.range_comp_of_range_eq_top qR
      (LinearMap.range_rangeRestrict L)
  have hqrank : Module.finrank F (LinearMap.range qL) =
      Module.finrank F (LinearMap.range qR) :=
    congrArg (fun S : Submodule F (V d ⧸ A) => Module.finrank F S) hqrange
  have hnullR := LinearMap.finrank_range_add_finrank_ker qR
  have hdimR : Module.finrank F R =
      Module.finrank F (LinearMap.range qL) + Module.finrank F A := by
    rw [hqrank]
    rw [hkerR, hARdim] at hnullR
    exact hnullR.symm
  have hmatrixRank : Y.rank = Module.finrank F R := by
    change Matrix.rank Y = Module.finrank F (LinearMap.range L)
    rw [← Matrix.rank_transpose Y]
    rw [Matrix.rank_eq_finrank_range_toLin Y.transpose
      (Pi.basisFun F _) (Pi.basisFun F _)]
    rw [Matrix.toLin_eq_toLin']
  have hkerBound : LinearMap.ker qL ≤ B := by
    intro x hx
    have hxzero : A.mkQ (L x) = 0 := by
      simpa [qL, LinearMap.mem_ker] using hx
    have hxA : L x ∈ A := by
      have hmem : L x ∈ LinearMap.ker A.mkQ := LinearMap.mem_ker.mpr hxzero
      rw [Submodule.ker_mkQ] at hmem
      exact hmem
    exact hsel.2 x hxA
  have hkerB : LinearMap.ker qB =
      (LinearMap.ker qL).comap B.subtype := by
    ext b
    simp [qB, qL, LinearMap.mem_ker, LinearMap.domRestrict_apply]
  have hkerDim : Module.finrank F (LinearMap.ker qB) =
      Module.finrank F (LinearMap.ker qL) := by
    rw [hkerB]
    exact (Submodule.comapSubtypeEquivOfLe hkerBound).finrank_eq
  have hnullL := LinearMap.finrank_range_add_finrank_ker qL
  have hnullB := LinearMap.finrank_range_add_finrank_ker qB
  have hquotB := B.finrank_quotient_add_finrank
  change Module.finrank F (W n ⧸ B) + Module.finrank F B =
      Module.finrank F (W n) at hquotB
  have hqRankSplit : Module.finrank F (LinearMap.range qL) =
      Module.finrank F (W n ⧸ B) + Module.finrank F (LinearMap.range qB) := by
    rw [hkerDim] at hnullB
    omega
  calc
    Y.rank = Module.finrank F R := hmatrixRank
    _ = Module.finrank F (LinearMap.range qL) + Module.finrank F A := hdimR
    _ = Module.finrank F (W n ⧸ B) +
          Module.finrank F (LinearMap.range qB) + Module.finrank F A := by
      rw [hqRankSplit]
    _ = Module.finrank F A + Module.finrank F (W n ⧸ B) +
          Module.finrank F (LinearMap.range qB) := by omega

/-- The below-cost ambient rank layer vanishes after the genuine affine
derivative filter. -/
theorem actual_derivative_rank_projection_zero_below_cost
    {n d i : Nat} (A : Submodule F (V d)) (B : Submodule F (W n))
    (T : V d →ₗ[F] W n) (f : BinaryMatrix n d → Complex)
    (hi : i < Module.finrank F A + Module.finrank F (W n ⧸ B)) :
    filteredCarrierFunction A B T (complexRankProjection i f) = 0 :=
  filteredCarrierFunction_rankProjection_zero_of_below_carrier A B T f hi

/-- On the reduced carrier, a single typed rank projection contracts
normalized squared energy by Parseval/Bessel. -/
theorem typed_carrier_rank_projection_energy_le
    {n d j : Nat} (A : Submodule F (V d)) (B : Submodule F (W n))
    (g : ((V d ⧸ A) →ₗ[F] B) → Complex) :
    BinaryMatrixA1TypedFourier.carrierMean A B
      (fun M => Complex.normSq (typedComplexRankProjection A B j g M)) ≤
    BinaryMatrixA1TypedFourier.carrierMean A B
      (fun M => Complex.normSq (g M)) :=
  typedComplexRankProjection_energy_le A B g

end
end PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection
