import PvNP.RealizableHardness.ActualBinaryMatrixHC46A17FixedSlice

/-! Transfer actual globalness of a fixed-domain derivative to its further
reduced affine slices, preserving the chosen base and normalized fibre mean. -/

namespace PvNP.RealizableHardness.ActualBinaryMatrixHC46A17DerivativeGlobalTransfer

open PvNP.RealizableHardness.ActualBinaryMatrixHC46A17FixedSlice
open PvNP.RealizableHardness.BinaryMatrixTypedA15Transport
open PvNP.RealizableHardness.BinaryMatrixA15NestedLine
open PvNP.RealizableHardness.BinaryMatrixFourier
open PvNP.RealizableHardness.BinaryMatrixComplexA15
open PvNP.RealizableHardness.BinaryMatrixTypedA15ReducedGlobal
open PvNP.RealizableHardness.ActualTypedABCanonicalDCollapse

noncomputable section
set_option autoImplicit false
attribute [local instance] Classical.propDecidable

private abbrev F := ZMod 2
private abbrev V (d : Nat) := Fin d → F
private abbrev W (n : Nat) := Fin n → F

/-! The fixed-domain derivative on `Hom(V/U,W)`, in its actual matrix
coordinates. -/
def fixedDomainDerivativeCoordinate {n d : Nat}
    (U : Submodule F (V d)) (T : V d →ₗ[F] W n)
    (f : BinaryMatrix n d → Complex)
    (X : BinaryMatrix (Module.finrank F (W n))
      (Module.finrank F (V d ⧸ U))) : Complex :=
  filteredCarrierFunction U (⊤ : Submodule F (W n)) T f
    ((carrierMatrixEquiv U (⊤ : Submodule F (W n))).symm X)

/-! The coordinate matrix model and the typed quotient carrier have the same
order bounds and normalized fibre energies. -/
theorem actual_derivative_global_implies_typed
    {n d r : Nat} {ε : Real}
    (U : Submodule F (V d))
    (g : ((V d ⧸ U) →ₗ[F] (⊤ : Submodule F (W n))) → Complex)
    (hg : UpToActualNormSqGlobal r ε
      (fun X => g ((carrierMatrixEquiv U (⊤ : Submodule F (W n))).symm X))) :
    UpToTypedNormSqGlobal U (⊤ : Submodule F (W n)) r ε g := by
  exact (typed_global_iff_coordinate U (⊤ : Submodule F (W n)) g).2 hg

/-! Actual-globalness of the fixed-domain derivative yields its complete
typed globalness on the quotient carrier. This is the input to the
order-accounted preimage-slice lemma; it does not erase the fixed subspace
`A/U` when that slice is selected. -/
theorem actual_fixed_domain_derivative_to_typed_global
    {n d r : Nat} {ε : Real}
    (U : Submodule F (V d)) (T : V d →ₗ[F] W n)
    (f : BinaryMatrix n d → Complex)
    (hderiv : UpToActualNormSqGlobal (r - 1) ε
      (fixedDomainDerivativeCoordinate U T f)) :
    UpToTypedNormSqGlobal U (⊤ : Submodule F (W n)) (r - 1) ε
      (filteredCarrierFunction U (⊤ : Submodule F (W n)) T f) := by
  exact actual_derivative_global_implies_typed U
    (filteredCarrierFunction U (⊤ : Submodule F (W n)) T f) (by
      simpa [fixedDomainDerivativeCoordinate] using hderiv)

/-- The actual-global derivative premise bounds the normalized energy on
every typed parent fibre of order at most `r - 1`.  In particular, a parent
domain containing U and any codomain variation are handled by the single
restriction `Q`; its order already includes both costs. -/
theorem actual_fixed_domain_derivative_carrier_fibre_energy_le
    {n d r : Nat} {ε : Real}
    (U : Submodule F (V d)) (T : V d →ₗ[F] W n)
    (f : BinaryMatrix n d → Complex)
    (hderiv : UpToActualNormSqGlobal (r - 1) ε
      (fixedDomainDerivativeCoordinate U T f))
    (Q : CarrierRestriction U (⊤ : Submodule F (W n)))
    (hQ : Q.order ≤ r - 1) :
    (∑ M ∈ Q.fibre,
      Complex.normSq (filteredCarrierFunction U (⊤ : Submodule F (W n)) T f M)) /
        Q.fibre.card ≤ ε := by
  exact (actual_fixed_domain_derivative_to_typed_global
    U T f hderiv) Q hQ

end
end PvNP.RealizableHardness.ActualBinaryMatrixHC46A17DerivativeGlobalTransfer
