import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.Tactic
import PvNP.RealizableHardness.ActualBinaryMatrixHC46A18Conditioning

/-!
The section-coordinate law behind the quotient-conditioned A18 step.

For fixed quotients `q : X' → X` and a section `s`, the unrestricted
functional coordinates are the linear functional `lambda` on `X`.  The
source sample consists of a map `R : X → B`, the reference functional on
`X'`, and the new vector `w`.  This file records the exact resulting map and
its section and distinguished-vector columns, plus its stable/expanded
codomain range.  It does not identify a globalness bound until the source
random choices are proved to be uniform in these coordinates.
-/
namespace PvNP.RealizableHardness.ActualBinaryMatrixHC46A18QuotientSamplingLaw

open PvNP.RealizableHardness.ActualBinaryMatrixHC46A18Conditioning

noncomputable section
attribute [local instance] Classical.propDecidable

variable {K X X' W : Type*} [Field K]
variable [AddCommGroup X] [Module K X]
variable [AddCommGroup X'] [Module K X']
variable [AddCommGroup W] [Module K W]

/-- The ambient version of the kernel of a functional on `A`. -/
def functionalKernelInAmbient (A : Submodule K X) (phi : A →ₗ[K] K) :
    Submodule K X := (LinearMap.ker phi).map A.subtype

/-- The factor map from the quotient by the restricted-functional kernel to
the quotient by `A`. Its kernel is the image of `A` in the smaller quotient.
This is the source-specific one-dimensional kernel identity used for A18. -/
theorem quotient_factor_kernel_eq_image (A : Submodule K X)
    (phi : A →ₗ[K] K) :
    LinearMap.ker
      (Submodule.factor
        (p := functionalKernelInAmbient A phi) (p' := A)
        (by
          intro x hx
          rcases hx with ⟨a, ha, rfl⟩
          exact a.property)) =
      A.map (Submodule.mkQ (functionalKernelInAmbient A phi)) := by
  rw [Submodule.ker_mapQ]
  rfl

/-- The image of `A` in the quotient by the restricted-functional kernel is
the line generated by the class of any `v` with `phi v = 1`. -/
theorem quotient_image_A_eq_span (A : Submodule K X)
    (phi : A →ₗ[K] K) (v : A) (hv : phi v = 1) :
    A.map (Submodule.mkQ (functionalKernelInAmbient A phi)) =
      Submodule.span K
        ({Submodule.mkQ (functionalKernelInAmbient A phi)
          (v : X)} : Set (X ⧸ functionalKernelInAmbient A phi)) := by
  apply le_antisymm
  · rintro y ⟨a, ha, rfl⟩
    let aa : A := ⟨a, ha⟩
    apply Submodule.mem_span_singleton.mpr
    refine ⟨phi aa, ?_⟩
    have hk : (aa - (phi aa) • v) ∈ LinearMap.ker phi := by
      change phi (aa - (phi aa) • v) = 0
      rw [map_sub, map_smul, hv]
      simp
    have hdiff : ((aa - (phi aa) • v : A) : X) ∈
        functionalKernelInAmbient A phi := ⟨aa - (phi aa) • v, hk, rfl⟩
    have hq' :
        Submodule.mkQ (functionalKernelInAmbient A phi) (aa : X) =
          Submodule.mkQ (functionalKernelInAmbient A phi)
            ((phi aa) • (v : X)) := by
      exact (Submodule.Quotient.eq (functionalKernelInAmbient A phi)).2 hdiff
    have hq : Submodule.mkQ (functionalKernelInAmbient A phi) (a : X) =
        Submodule.mkQ (functionalKernelInAmbient A phi) ((phi aa) • (v : X)) := by
      simpa only [aa] using hq'
    change phi aa • Submodule.mkQ (functionalKernelInAmbient A phi) (v : X) =
      Submodule.mkQ (functionalKernelInAmbient A phi) (a : X)
    rw [← map_smul (Submodule.mkQ (functionalKernelInAmbient A phi)) (phi aa) (v : X)]
    exact hq.symm
  · intro y hy
    rcases Submodule.mem_span_singleton.mp hy with ⟨c, hc⟩
    refine ⟨c • (v : X), A.smul_mem c v.property, ?_⟩
    change Submodule.mkQ (functionalKernelInAmbient A phi)
        (c • (v : X)) = y
    simpa only [Submodule.mkQ_apply, Submodule.Quotient.mk_smul] using hc

/-- For the actual restricted-functional quotient, the factor map has the
one-dimensional kernel required by the A18 section construction. -/
theorem quotient_factor_kernel_eq_span (A : Submodule K X)
    (phi : A →ₗ[K] K) (v : A) (hv : phi v = 1) :
    LinearMap.ker
      (Submodule.factor
        (p := functionalKernelInAmbient A phi) (p' := A)
        (by
          intro x hx
          rcases hx with ⟨a, ha, rfl⟩
          exact a.property)) =
      Submodule.span K
        ({Submodule.mkQ (functionalKernelInAmbient A phi)
          (v : X)} : Set (X ⧸ functionalKernelInAmbient A phi)) := by
  rw [quotient_factor_kernel_eq_image, quotient_image_A_eq_span A phi v hv]

/-- The map on the enlarged quotient: the old random map factors through
`q`, while the functional coordinate contributes the new column. -/
def quotientSampleOutput (B : Submodule K W)
    (q : X' →ₗ[K] X) (phi₀ : X' →ₗ[K] K)
    (R : X →ₗ[K] B) (lambda : X →ₗ[K] K) (w : W) : X' →ₗ[K] W :=
  B.subtype.comp (R.comp q) + (phi₀ + lambda.comp q).smulRight w

/-- On the chosen section, the resulting column is exactly the old uniform
`B`-column plus the independent `lambda` bit times `w`. -/
theorem quotientSampleOutput_section (B : Submodule K W)
    (q : X' →ₗ[K] X) (s : X →ₗ[K] X') (phi₀ : X' →ₗ[K] K)
    (R : X →ₗ[K] B) (lambda : X →ₗ[K] K) (w : W)
    (hqs : q.comp s = LinearMap.id) (hphiS : phi₀.comp s = 0)
    (x : X) :
    quotientSampleOutput B q phi₀ R lambda w (s x) =
      (R x : W) + lambda x • w := by
  have hq : q (s x) = x := by
    have h := congrArg (fun f : X →ₗ[K] X => f x) hqs
    simpa using h
  have hphi : phi₀ (s x) = 0 := by
    have h := congrArg (fun f : X →ₗ[K] K => f x) hphiS
    simpa using h
  simp [quotientSampleOutput, hq, hphi]

/-- The distinguished new column is exactly `w`, independent of both old
map and quotient-functional coordinates. -/
theorem quotientSampleOutput_newColumn (B : Submodule K W)
    (q : X' →ₗ[K] X) (phi₀ : X' →ₗ[K] K)
    (R : X →ₗ[K] B) (lambda : X →ₗ[K] K) (w : W) (v : X')
    (hqv : q v = 0) (hphiV : phi₀ v = 1) :
    quotientSampleOutput B q phi₀ R lambda w v = w := by
  simp [quotientSampleOutput, hqv, hphiV]

/-- In the stable branch, where the new vector already lies in `B`, the
sampled map still has range in `B`. -/
theorem quotientSampleOutput_range_stable (B : Submodule K W)
    (q : X' →ₗ[K] X) (phi₀ : X' →ₗ[K] K)
    (R : X →ₗ[K] B) (lambda : X →ₗ[K] K) (w : W) (hw : w ∈ B) :
    LinearMap.range (quotientSampleOutput B q phi₀ R lambda w) ≤ B := by
  intro y hy
  rcases hy with ⟨x, rfl⟩
  change ((R (q x) : W) + (phi₀ x + lambda (q x)) • w) ∈ B
  exact B.add_mem (R (q x)).property (B.smul_mem _ hw)

/-- In the expanded branch, the sampled map has range in the actual enlarged
codomain subspace. -/
theorem quotientSampleOutput_range_expanded (B B' : Submodule K W)
    (hBB' : B ≤ B') (q : X' →ₗ[K] X) (phi₀ : X' →ₗ[K] K)
    (R : X →ₗ[K] B) (lambda : X →ₗ[K] K) (w : W) (hw : w ∈ B') :
    LinearMap.range (quotientSampleOutput B q phi₀ R lambda w) ≤ B' := by
  intro y hy
  rcases hy with ⟨x, rfl⟩
  change ((R (q x) : W) + (phi₀ x + lambda (q x)) • w) ∈ B'
  exact B'.add_mem (hBB' (R (q x)).property) (B'.smul_mem _ hw)

/-- The source quotient and its one-dimensional kernel coordinate give the
product coordinates used by the finite sampling equivalence. The
decomposition identity is the quotient/section equation to discharge when
instantiating this helper with A′ ≤ A and v ∈ A \ A′. -/
noncomputable def quotientSectionCoordinateEquiv
    (q : X' →ₗ[K] X) (s : X →ₗ[K] X') (phi₀ : X' →ₗ[K] K) (v : X')
    (hdecomp : ∀ x, x = s (q x) + phi₀ x • v)
    (hqs : q.comp s = LinearMap.id) (hqv : q v = 0)
    (hphiS : phi₀.comp s = 0) (hphiV : phi₀ v = 1) :
    X' ≃ₗ[K] X × K :=
  LinearEquiv.ofBijective (LinearMap.prod q phi₀) <| by
    constructor
    · intro x y hxy
      have hq : q x = q y := congrArg Prod.fst hxy
      have hphi : phi₀ x = phi₀ y := congrArg Prod.snd hxy
      calc
        x = s (q x) + phi₀ x • v := hdecomp x
        _ = s (q y) + phi₀ y • v := by rw [hq, hphi]
        _ = y := (hdecomp y).symm
    · intro p
      refine ⟨s p.1 + p.2 • v, ?_⟩
      have hs : q (s p.1) = p.1 := by
        have h := congrArg (fun f : X →ₗ[K] X => f p.1) hqs
        simpa using h
      have hv : phi₀ (s p.1) = 0 := by
        have h := congrArg (fun f : X →ₗ[K] K => f p.1) hphiS
        simpa using h
      ext <;> simp [hs, hv, hqv, hphiV]

/-- Every surjection with a one-dimensional kernel admits quotient-section
coordinates. The kernel line is identified with K by its specified nonzero
vector; the complementary subspace is chosen using the vector-space
complement theorem. -/
 theorem quotientSectionCoordinates_of_kernel_line
    (q : X' →ₗ[K] X) (v : X') (hq : Function.Surjective q)
    (hker : LinearMap.ker q = Submodule.span K ({v} : Set X'))
    (hv : v ≠ 0) :
    ∃ s : X →ₗ[K] X', ∃ phi₀ : X' →ₗ[K] K,
      q.comp s = LinearMap.id ∧ q v = 0 ∧ phi₀.comp s = 0 ∧
      phi₀ v = 1 ∧ ∀ x, x = s (q x) + phi₀ x • v := by
  classical
  let Kq : Submodule K X' := LinearMap.ker q
  have hker' : Kq = Submodule.span K ({v} : Set X') := hker
  let eVmap : K →ₗ[K] Kq :=
    { toFun := fun a => ⟨a • v, by
        rw [hker']
        exact Submodule.smul_mem _ _
          (Submodule.subset_span (Set.mem_singleton v))⟩
      map_add' := by
        intro a b
        apply Subtype.ext
        simp [add_smul]
      map_smul' := by
        intro a b
        apply Subtype.ext
        simp [smul_smul] }
  have eVmap_inj : Function.Injective eVmap := by
    intro a b hab
    apply smul_left_injective K hv
    exact congrArg Subtype.val hab
  have eVmap_surj : Function.Surjective eVmap := by
    intro z
    have hzspan : (z : X') ∈ Submodule.span K ({v} : Set X') := by
      rw [← hker']
      exact z.property
    rcases Submodule.mem_span_singleton.mp hzspan with ⟨a, ha⟩
    refine ⟨a, ?_⟩
    apply Subtype.ext
    exact ha
  let eV : K ≃ₗ[K] Kq := LinearEquiv.ofBijective eVmap
    ⟨eVmap_inj, eVmap_surj⟩
  obtain ⟨C, hC⟩ := Kq.exists_isCompl
  let eSplit : (Kq × C) ≃ₗ[K] X' := Kq.prodEquivOfIsCompl C hC
  let qC : C →ₗ[K] X := q.comp C.subtype
  have qC_inj : Function.Injective qC := by
    intro a b hab
    apply Subtype.ext
    have hdiffK : (a : X') - b ∈ Kq := by
      change q ((a : X') - (b : X')) = 0
      have habq : q (a : X') = q (b : X') := by
        simpa [qC] using hab
      rw [map_sub, habq]
      simp
    have hdiffC : (a : X') - b ∈ C := C.sub_mem a.property b.property
    have hbot : (a : X') - b ∈ (⊥ : Submodule K X') := by
      have hbot : Kq ⊓ C = ⊥ := disjoint_iff.mp hC.disjoint
      rw [← hbot]
      exact ⟨hdiffK, hdiffC⟩
    exact sub_eq_zero.mp (by simpa using hbot)
  have qC_surj : Function.Surjective qC := by
    intro y
    obtain ⟨x, hx⟩ := hq y
    let z := eSplit.symm x
    have hsum : (z.1 : X') + (z.2 : X') = x := by
      have h := eSplit.apply_symm_apply x
      simpa [z, eSplit, Submodule.coe_prodEquivOfIsCompl'] using h
    refine ⟨z.2, ?_⟩
    change q (z.2 : X') = y
    have hqsum := congrArg q hsum
    rw [map_add] at hqsum
    rw [z.1.property, zero_add] at hqsum
    exact hqsum.trans hx
  let eC : C ≃ₗ[K] X := LinearEquiv.ofBijective qC ⟨qC_inj, qC_surj⟩
  let s : X →ₗ[K] X' := C.subtype.comp eC.symm.toLinearMap
  let pK : X' →ₗ[K] Kq :=
    (LinearMap.fst K Kq C).comp eSplit.symm.toLinearMap
  let phi₀ : X' →ₗ[K] K := eV.symm.toLinearMap.comp pK
  have hs : q.comp s = LinearMap.id := by
    ext x
    have hx := eC.apply_symm_apply x
    exact hx
  have hqv : q v = 0 := by
    have hvker : v ∈ LinearMap.ker q := by
      change v ∈ Kq
      rw [hker']
      exact Submodule.subset_span (Set.mem_singleton v)
    exact LinearMap.mem_ker.mp hvker
  have hphiS : phi₀.comp s = 0 := by
    ext x
    change eV.symm ((eSplit.symm (C.subtype (eC.symm x))).1) = 0
    have hsplit :=
      Submodule.prodEquivOfIsCompl_symm_apply_right Kq C hC (eC.symm x)
    change eSplit.symm (C.subtype (eC.symm x)) = (0, eC.symm x) at hsplit
    rw [hsplit]
    simp
  have hphiV : phi₀ v = 1 := by
    let vk : Kq := ⟨v, by rw [hker']; exact Submodule.subset_span (Set.mem_singleton v)⟩
    have hvsplit : eSplit (vk, (0 : C)) = v := by
      simp [eSplit, vk, Submodule.coe_prodEquivOfIsCompl']
    have hproj : pK v = vk := by
      change (eSplit.symm v).1 = vk
      rw [← hvsplit]
      exact congrArg Prod.fst (eSplit.symm_apply_apply (vk, (0 : C)))
    change eV.symm (pK v) = 1
    rw [hproj]
    have hev : eV 1 = vk := by
      apply Subtype.ext
      change eVmap 1 = v
      simp [eVmap, vk]
    exact eV.symm_apply_eq.mpr hev.symm
  refine ⟨s, phi₀, hs, hqv, hphiS, hphiV, ?_⟩
  intro x
  let z := eSplit.symm x
  have hsum : (z.1 : X') + (z.2 : X') = x := by
    have h := eSplit.apply_symm_apply x
    simpa [z, eSplit, Submodule.coe_prodEquivOfIsCompl'] using h
  have hqpart : eC z.2 = q x := by
    have h := congrArg q hsum
    rw [map_add] at h
    rw [z.1.property, zero_add] at h
    exact h
  have hCpart : (z.2 : X') = s (q x) := by
    have : z.2 = eC.symm (q x) := by
      apply eC.injective
      simpa using hqpart
    simpa [s] using congrArg Subtype.val this
  have hKpart : (z.1 : X') = phi₀ x • v := by
    have hcoord : eV (phi₀ x) = z.1 := by
      change eV (eV.symm (pK x)) = z.1
      simp [phi₀, pK, z, eSplit]
    have hval := congrArg Subtype.val hcoord
    change phi₀ x • v = (z.1 : X') at hval
    exact hval.symm
  calc
    x = (z.1 : X') + (z.2 : X') := hsum.symm
    _ = s (q x) + phi₀ x • v := by rw [hCpart, hKpart]; abel

/-- Source-specific section coordinates for the quotient by the kernel of a
functional on `A`. The quotient factor is surjective and has kernel the
specified line, so the abstract section construction applies without a
caller-supplied splitting law. -/
theorem quotientSectionCoordinates_of_restricted_functional
    (A : Submodule K X) (phi : A →ₗ[K] K) (v : A) (hv : phi v = 1) :
    ∃ s : (X ⧸ A) →ₗ[K] (X ⧸ functionalKernelInAmbient A phi),
      ∃ phi₀ : (X ⧸ functionalKernelInAmbient A phi) →ₗ[K] K,
        let q := Submodule.factor
          (p := functionalKernelInAmbient A phi) (p' := A)
          (by
            intro x hx
            rcases hx with ⟨a, ha, rfl⟩
            exact a.property)
        q.comp s = LinearMap.id ∧
        q (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) = 0 ∧
        phi₀.comp s = 0 ∧
        phi₀ (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) = 1 ∧
        ∀ x, x = s (q x) + phi₀ x •
          Submodule.mkQ (functionalKernelInAmbient A phi) (v : X) := by
  let A' := functionalKernelInAmbient A phi
  let q : (X ⧸ A') →ₗ[K] (X ⧸ A) :=
    Submodule.factor (p := A') (p' := A) (by
      intro x hx
      rcases hx with ⟨a, ha, rfl⟩
      exact a.property)
  let vq : X ⧸ A' := Submodule.mkQ A' (v : X)
  have hqsurj : Function.Surjective q := Submodule.factor_surjective _
  have hqker : LinearMap.ker q = Submodule.span K ({vq} : Set (X ⧸ A')) := by
    simpa [q, vq, A'] using quotient_factor_kernel_eq_span A phi v hv
  have hvq : vq ≠ 0 := by
    intro hz
    have hmem : (v : X) ∈ A' := by
      have hmemker : (v : X) ∈ LinearMap.ker (Submodule.mkQ A') :=
        LinearMap.mem_ker.mpr hz
      simpa only [Submodule.ker_mkQ] using hmemker
    rcases hmem with ⟨a, ha, hav⟩
    have havA : a = v := Subtype.ext hav
    have hphi0 : phi v = 0 := by
      calc
        phi v = phi a := congrArg phi havA.symm
        _ = 0 := ha
    exact one_ne_zero (hv.symm.trans hphi0)
  have hsource := quotientSectionCoordinates_of_kernel_line q vq hqsurj hqker hvq
  let s := Classical.choose hsource
  have hphiSource := Classical.choose_spec hsource
  let phi₀ := Classical.choose hphiSource
  have hparts := Classical.choose_spec hphiSource
  rcases hparts with ⟨hqs, hqv, hphiS, hphiV, hdecomp⟩
  exact ⟨s, phi₀, hqs, hqv, hphiS, hphiV, hdecomp⟩

/-- In product coordinates, every linear map whose distinguished column is
w is uniquely a pair of an old-map coordinate and an independent
functional coordinate. This is the finite fibre bijection used after fixing
the parent subspace and the expanded codomain branch. -/
  def productMapFromCoordinates {B : Type*} [AddCommGroup B] [Module K B]
      (p : (X →ₗ[K] B) × (X →ₗ[K] K)) :
    X × K →ₗ[K] B × K :=
  LinearMap.prod
    (p.1.comp (LinearMap.fst K X K))
    (p.2.comp (LinearMap.fst K X K) + LinearMap.snd K X K)

/-- The coordinate map for the one-vector codomain extension. -/
  def expandedCodomainCoordinateMap (B : Submodule K W) (w : W) :
    (B × K) →ₗ[K] spanExtensionSubmodule B w where
  toFun p := ⟨(p.1 : W) + p.2 • w, by
    dsimp [spanExtensionSubmodule]
    exact Submodule.add_mem _ (Submodule.mem_sup_left p.1.property)
      (Submodule.mem_sup_right (Submodule.smul_mem _ _
        (Submodule.subset_span (Set.mem_singleton w))))⟩
  map_add' p q := by
    apply Subtype.ext
    change (↑p.1 + ↑q.1) + (p.2 + q.2) • w =
      (↑p.1 + p.2 • w) + (↑q.1 + q.2 • w)
    rw [add_smul]
    abel
  map_smul' c p := by
    apply Subtype.ext
    change (c • (p.1 : W)) + (c • p.2) • w = c • ((p.1 : W) + p.2 • w)
    rw [smul_add, smul_smul]
    simp only [smul_eq_mul]

/-- The one-vector extension `B ⊔ span{w}` is linearly equivalent to
`B × K` when `w` is outside `B`. This is the actual codomain coordinate
system for the expanded branch. -/
noncomputable def expandedCodomainReconstructionEquiv (B : Submodule K W) (w : W)
    (hw : w ∉ B) : (B × K) ≃ₗ[K] spanExtensionSubmodule B w :=
  LinearEquiv.ofBijective (expandedCodomainCoordinateMap B w) <| by
    constructor
    · intro p q hpq
      have hv := congrArg (fun z : spanExtensionSubmodule B w => (z : W)) hpq
      change (p.1 : W) + p.2 • w = (q.1 : W) + q.2 • w at hv
      have hcoef : (p.2 - q.2) • w = (q.1 : W) - (p.1 : W) := by
        have hsum : p.2 • w - q.2 • w = (q.1 : W) - (p.1 : W) := by
          calc
            p.2 • w - q.2 • w =
                ((p.1 : W) + p.2 • w) - ((p.1 : W) + q.2 • w) := by abel
            _ = ((q.1 : W) + q.2 • w) - ((p.1 : W) + q.2 • w) := by rw [hv]
            _ = (q.1 : W) - (p.1 : W) := by abel
        simpa only [sub_smul] using hsum
      by_cases hk : p.2 = q.2
      · have hb : (p.1 : W) = q.1 := by
          have h := hv
          rw [hk] at h
          exact add_right_cancel h
        exact Prod.ext (Subtype.ext hb) hk
      · have hmem : (p.2 - q.2) • w ∈ B := by
          rw [hcoef]
          exact B.sub_mem q.1.property p.1.property
        have hwB : w ∈ B := by
          have hscaled := B.smul_mem (p.2 - q.2)⁻¹ hmem
          simpa [smul_smul, inv_mul_cancel₀ (sub_ne_zero.mpr hk)] using hscaled
        exact (hw hwB).elim
    · intro z
      rcases Submodule.mem_sup.mp z.property with ⟨b, hb, c, hc, hbc⟩
      rcases Submodule.mem_span_singleton.mp hc with ⟨k, hk⟩
      refine ⟨(⟨b, hb⟩, k), ?_⟩
      apply Subtype.ext
      change (b : W) + k • w = (z : W)
      rw [← hbc, ← hk]
/-- The forward coordinate map on the actual enlarged codomain. -/
noncomputable def expandedCodomainCoordinateEquiv (B : Submodule K W) (w : W)
    (hw : w ∉ B) : spanExtensionSubmodule B w ≃ₗ[K] B × K :=
  (expandedCodomainReconstructionEquiv B w hw).symm
/-- The distinguished outside vector has coordinate `(0,1)` in the actual
expanded-codomain equivalence. -/
theorem expandedCodomainCoordinateEquiv_newColumn (B : Submodule K W) (w : W)
    (hw : w ∉ B) :
    expandedCodomainCoordinateEquiv B w hw
      ⟨w, Submodule.mem_sup_right
        (Submodule.subset_span (Set.mem_singleton w))⟩ = (0, 1) := by
  let e := expandedCodomainReconstructionEquiv B w hw
  have he : e (0, 1) =
      (⟨w, Submodule.mem_sup_right
        (Submodule.subset_span (Set.mem_singleton w))⟩ : spanExtensionSubmodule B w) := by
    apply Subtype.ext
    change (0 : W) + (1 : K) • w = w
    simp
  change e.symm
      ⟨w, Submodule.mem_sup_right
        (Submodule.subset_span (Set.mem_singleton w))⟩ = (0, 1)
  rw [← he]
  exact e.symm_apply_apply (0, 1)

  def coordinatesOfMap {B : Type*} [AddCommGroup B] [Module K B]
      (eD : X' ≃ₗ[K] X × K) (eC : W ≃ₗ[K] B × K)
    (N : X' →ₗ[K] W) : (X →ₗ[K] B) × (X →ₗ[K] K) :=
  let T := eC.toLinearMap.comp (N.comp eD.symm.toLinearMap)
  ( (LinearMap.fst K B K).comp
      (T.comp (LinearMap.inl K X K)),
    (LinearMap.snd K B K).comp
      (T.comp (LinearMap.inl K X K)) )

  noncomputable def fixedColumnCoordinateEquiv {B : Type*} [AddCommGroup B] [Module K B]
    (eD : X' ≃ₗ[K] X × K) (eC : W ≃ₗ[K] (B × K))
    (v : X') (w : W) (hDv : eD v = (0, 1)) (hCw : eC w = (0, 1)) :
    {N : X' →ₗ[K] W // N v = w} ≃
      (X →ₗ[K] B) × (X →ₗ[K] K) where
  toFun N := coordinatesOfMap eD eC N.1
  invFun p := by
    let T := productMapFromCoordinates p
    refine ⟨eC.symm.toLinearMap.comp (T.comp eD.toLinearMap), ?_⟩
    have hT : T (0, 1) = (0, 1) := by
      simp [T, productMapFromCoordinates]
    have hsymm : eC.symm (0, 1) = w := by
      apply eC.injective
      simpa using hCw.symm
    change eC.symm (T (eD v)) = w
    rw [hDv, hT, hsymm]
  left_inv N := by
    apply Subtype.ext
    apply LinearMap.ext
    intro z
    let T := eC.toLinearMap.comp (N.1.comp eD.symm.toLinearMap)
    let P := coordinatesOfMap eD eC N.1
    have hT : T (0, 1) = (0, 1) := by
      have h := congrArg eC.toLinearMap N.2
      have hvD : eD.symm (0, 1) = v := by
        apply eD.injective
        simpa [hDv]
      change eC.toLinearMap (N.1 (eD.symm (0, 1))) = (0, 1)
      rw [hvD, N.2]
      exact hCw
    apply eC.injective
    have hrhs : eC (N.1 z) = T (eD z) := by
      dsimp [T]
      simp [LinearMap.comp_apply, LinearEquiv.apply_symm_apply]
    calc
      eC (eC.symm (productMapFromCoordinates P (eD z))) =
          productMapFromCoordinates P (eD z) := eC.apply_symm_apply _
      _ = T (eD z) := by
        symm
        have hdecomp : eD z = ((eD z).1, 0) + (0, (eD z).2) := by
          ext <;> simp
        rw [hdecomp, map_add]
        have hsecond :
            T (0, (eD z).2) = (eD z).2 • (0, 1) := by
          rw [show (0, (eD z).2) = (eD z).2 • ((0, 1) : X × K) by ext <;> simp]
          rw [map_smul, hT]
        rw [hsecond]
        have hfirst :
            T ((eD z).1, 0) = (P.1 (eD z).1, P.2 (eD z).1) := by
          simp only [T, P, coordinatesOfMap, LinearMap.comp_apply,
            LinearMap.fst_apply, LinearMap.snd_apply, LinearMap.inl_apply]
        rw [hfirst]
        simp [productMapFromCoordinates]
      _ = eC (N.1 z) := hrhs.symm
  right_inv p := by
    apply Prod.ext
    · apply LinearMap.ext
      intro x
      simp [coordinatesOfMap, productMapFromCoordinates,
        LinearMap.comp_apply, LinearEquiv.apply_symm_apply]
    · apply LinearMap.ext
      intro x
      simp [coordinatesOfMap, productMapFromCoordinates,
        LinearMap.comp_apply, LinearEquiv.apply_symm_apply]

/-- The quotient section and the actual one-vector codomain extension give
an explicit coordinate bijection for maps with the sampled distinguished
column. The hypotheses are the quotient/section identities, not a sampling
law or energy bound. -/
noncomputable def quotientAppendSamplingEquiv
    (B : Submodule K W) (w : W) (hw : w ∉ B)
    (q : X' →ₗ[K] X) (s : X →ₗ[K] X') (phi₀ : X' →ₗ[K] K) (v : X')
    (hdecomp : ∀ x, x = s (q x) + phi₀ x • v)
    (hqs : q.comp s = LinearMap.id) (hqv : q v = 0)
    (hphiS : phi₀.comp s = 0) (hphiV : phi₀ v = 1) :
    {N : X' →ₗ[K] spanExtensionSubmodule B w //
      N v = ⟨w, Submodule.mem_sup_right
        (Submodule.subset_span (Set.mem_singleton w))⟩} ≃
      (X →ₗ[K] B) × (X →ₗ[K] K) := by
  let eD : X' ≃ₗ[K] X × K :=
    quotientSectionCoordinateEquiv q s phi₀ v hdecomp hqs hqv hphiS hphiV
  let eC : spanExtensionSubmodule B w ≃ₗ[K] B × K :=
    expandedCodomainCoordinateEquiv B w hw
  have hDv : eD v = (0, 1) := by
    change (q v, phi₀ v) = (0, 1)
    exact Prod.ext hqv hphiV
  have hCw := expandedCodomainCoordinateEquiv_newColumn B w hw
  exact fixedColumnCoordinateEquiv eD eC v
    ⟨w, Submodule.mem_sup_right
      (Submodule.subset_span (Set.mem_singleton w))⟩ hDv hCw

/-- The source-shaped finite-coordinate bijection for a restricted
functional kernel and an appended vector outside `B`. This derives the
quotient section internally; callers need not assume a section, a fibre law,
or an energy estimate. -/
noncomputable def restrictedFunctionalAppendSamplingEquiv
    (A : Submodule K X) (phi : A →ₗ[K] K) (v : A) (hv : phi v = 1)
    (B : Submodule K W) (w : W) (hw : w ∉ B) :
    {N : (X ⧸ functionalKernelInAmbient A phi) →ₗ[K]
          spanExtensionSubmodule B w //
      N (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) =
        ⟨w, Submodule.mem_sup_right
          (Submodule.subset_span (Set.mem_singleton w))⟩} ≃
      ((X ⧸ A) →ₗ[K] B) × ((X ⧸ A) →ₗ[K] K) := by
  let A' := functionalKernelInAmbient A phi
  let q : (X ⧸ A') →ₗ[K] (X ⧸ A) :=
    Submodule.factor (p := A') (p' := A) (by
      intro x hx
      rcases hx with ⟨a, ha, rfl⟩
      exact a.property)
  have hsource := quotientSectionCoordinates_of_restricted_functional A phi v hv
  let s := Classical.choose hsource
  have hphiSource := Classical.choose_spec hsource
  let phi₀ := Classical.choose hphiSource
  have hparts := Classical.choose_spec hphiSource
  rcases hparts with ⟨hqs, hqv, hphiS, hphiV, hdecomp⟩
  exact quotientAppendSamplingEquiv B w hw q s phi₀
    (Submodule.mkQ A' (v : X)) hdecomp hqs hqv hphiS hphiV

/-- The map assembled from the source section and independent functional is
exactly the inverse-coordinate representative, after coercing its image into
the one-vector extension. -/
theorem quotientAppendSamplingEquiv_symm_apply
    (B : Submodule K W) (w : W) (hw : w ∉ B)
    (q : X' →ₗ[K] X) (s : X →ₗ[K] X') (phi₀ : X' →ₗ[K] K) (v : X')
    (hdecomp : ∀ x, x = s (q x) + phi₀ x • v)
    (hqs : q.comp s = LinearMap.id) (hqv : q v = 0)
    (hphiS : phi₀.comp s = 0) (hphiV : phi₀ v = 1)
    (R : X →ₗ[K] B) (lambda : X →ₗ[K] K) :
    (spanExtensionSubmodule B w).subtype.comp
      ((quotientAppendSamplingEquiv B w hw q s phi₀ v hdecomp hqs hqv hphiS hphiV).symm
        (R, lambda)).1 = quotientSampleOutput B q phi₀ R lambda w := by
  let eD : X' ≃ₗ[K] X × K :=
    quotientSectionCoordinateEquiv q s phi₀ v hdecomp hqs hqv hphiS hphiV
  let eC : spanExtensionSubmodule B w ≃ₗ[K] B × K :=
    expandedCodomainCoordinateEquiv B w hw
  let w' : spanExtensionSubmodule B w :=
    ⟨w, Submodule.mem_sup_right (Submodule.subset_span (Set.mem_singleton w))⟩
  have hRange : ∀ x, quotientSampleOutput B q phi₀ R lambda w x ∈
      spanExtensionSubmodule B w := by
    intro x
    have hx : quotientSampleOutput B q phi₀ R lambda w x ∈
        LinearMap.range (quotientSampleOutput B q phi₀ R lambda w) := ⟨x, rfl⟩
    exact quotientSampleOutput_range_expanded B (spanExtensionSubmodule B w)
      (le_sup_left) q phi₀ R lambda w (Submodule.mem_sup_right
        (Submodule.subset_span (Set.mem_singleton w))) hx
  let N : X' →ₗ[K] spanExtensionSubmodule B w :=
    (quotientSampleOutput B q phi₀ R lambda w).codRestrict _ hRange
  have hNpoint : N v = w' := by
    apply Subtype.ext
    exact quotientSampleOutput_newColumn B q phi₀ R lambda w v hqv hphiV
  have hsection_at (x : X) : eD (s x) = (x, 0) := by
    change (q (s x), phi₀ (s x)) = (x, 0)
    exact Prod.ext
      (by
        have h := congrArg (fun f : X →ₗ[K] X => f x) hqs
        simpa using h)
      (by
        have h := congrArg (fun f : X →ₗ[K] K => f x) hphiS
        simpa using h)
  have hinverse_section (x : X) : eD.symm (x, 0) = s x := by
    apply eD.injective
    rw [eD.apply_symm_apply, hsection_at]
  have hcoordinates (x : X) : eC (N (s x)) = (R x, lambda x) := by
    let eRec := expandedCodomainReconstructionEquiv B w hw
    have hrec : eRec (R x, lambda x) = N (s x) := by
      apply Subtype.ext
      calc
        (eRec (R x, lambda x) : W) = (R x : W) + lambda x • w := by
          rfl
        _ = quotientSampleOutput B q phi₀ R lambda w (s x) :=
          (quotientSampleOutput_section B q s phi₀ R lambda w hqs hphiS x).symm
        _ = (N (s x) : W) := rfl
    change eRec.symm (N (s x)) = (R x, lambda x)
    rw [← hrec]
    exact eRec.symm_apply_apply (R x, lambda x)
  have hcoords :
      quotientAppendSamplingEquiv B w hw q s phi₀ v hdecomp hqs hqv hphiS hphiV
        ⟨N, hNpoint⟩ = (R, lambda) := by
    apply Prod.ext
    · apply LinearMap.ext
      intro x
      dsimp [quotientAppendSamplingEquiv, fixedColumnCoordinateEquiv]
      change (eC (N (eD.symm (x, 0)))).1 = R x
      rw [hinverse_section x, hcoordinates x]
    · apply LinearMap.ext
      intro x
      dsimp [quotientAppendSamplingEquiv, fixedColumnCoordinateEquiv]
      change (eC (N (eD.symm (x, 0)))).2 = lambda x
      rw [hinverse_section x, hcoordinates x]
  have hInverse :
      (quotientAppendSamplingEquiv B w hw q s phi₀ v hdecomp hqs hqv hphiS hphiV).symm
        (R, lambda) = ⟨N, hNpoint⟩ := by
    apply (quotientAppendSamplingEquiv B w hw q s phi₀ v
      hdecomp hqs hqv hphiS hphiV).injective
    simpa using hcoords.symm
  apply LinearMap.ext
  intro x
  have hInverseVal := congrArg (fun n => n.1) hInverse
  have hcoerce := congrArg (fun f : X' →ₗ[K] spanExtensionSubmodule B w =>
      (spanExtensionSubmodule B w).subtype.comp f) hInverseVal
  have hNcoerce : (spanExtensionSubmodule B w).subtype.comp N =
      quotientSampleOutput B q phi₀ R lambda w := by
    ext y
    simp [N, LinearMap.codRestrict_apply]
  have hfinal := hcoerce.trans hNcoerce
  exact congrArg (fun f : X' →ₗ[K] W => f x) hfinal

/-- The finite-sum pushforward for the source-specific quotient fibre. This
is the exact uniform-coordinate law induced by the bijection, before any
conditioning on the outside-column event or any energy estimate. -/
theorem restrictedFunctionalAppendSampling_sum
    [Fintype X] [Fintype K] [Fintype W]
    (A : Submodule K X) (phi : A →ₗ[K] K) (v : A) (hv : phi v = 1)
    (B : Submodule K W) (w : W) (hw : w ∉ B)
    (g : {N : (X ⧸ functionalKernelInAmbient A phi) →ₗ[K]
              spanExtensionSubmodule B w //
          N (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) =
            ⟨w, Submodule.mem_sup_right
              (Submodule.subset_span (Set.mem_singleton w))⟩} → Real) :
    (∑ N : {N : (X ⧸ functionalKernelInAmbient A phi) →ₗ[K]
                spanExtensionSubmodule B w //
            N (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) =
              ⟨w, Submodule.mem_sup_right
                (Submodule.subset_span (Set.mem_singleton w))⟩}, g N) =
      ∑ p : ((X ⧸ A) →ₗ[K] B) × ((X ⧸ A) →ₗ[K] K),
        g ((restrictedFunctionalAppendSamplingEquiv A phi v hv B w hw).symm p) := by
  classical
  exact (Equiv.sum_comp
    (restrictedFunctionalAppendSamplingEquiv A phi v hv B w hw).symm
    (fun N => g N)).symm

/-- The normalized finite uniform mean is preserved by this source
equivalence for each fixed outside vector. The later source-level branch
conditioning and energy/Jensen estimate remain separate. -/
theorem restrictedFunctionalAppendSampling_mean
    [Fintype X] [Fintype K] [Fintype W]
    (A : Submodule K X) (phi : A →ₗ[K] K) (v : A) (hv : phi v = 1)
    (B : Submodule K W) (w : W) (hw : w ∉ B)
    (g : {N : (X ⧸ functionalKernelInAmbient A phi) →ₗ[K]
              spanExtensionSubmodule B w //
          N (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) =
            ⟨w, Submodule.mem_sup_right
              (Submodule.subset_span (Set.mem_singleton w))⟩} → Real) :
    (∑ N : {N : (X ⧸ functionalKernelInAmbient A phi) →ₗ[K]
                spanExtensionSubmodule B w //
            N (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) =
              ⟨w, Submodule.mem_sup_right
                (Submodule.subset_span (Set.mem_singleton w))⟩}, g N) /
        (Fintype.card {N : (X ⧸ functionalKernelInAmbient A phi) →ₗ[K]
                spanExtensionSubmodule B w //
            N (Submodule.mkQ (functionalKernelInAmbient A phi) (v : X)) =
              ⟨w, Submodule.mem_sup_right
                (Submodule.subset_span (Set.mem_singleton w))⟩} : Real) =
      (∑ p : ((X ⧸ A) →ₗ[K] B) × ((X ⧸ A) →ₗ[K] K),
        g ((restrictedFunctionalAppendSamplingEquiv A phi v hv B w hw).symm p)) /
        (Fintype.card (((X ⧸ A) →ₗ[K] B) × ((X ⧸ A) →ₗ[K] K)) : Real) := by
  rw [restrictedFunctionalAppendSampling_sum A phi v hv B w hw g,
    Fintype.card_congr (restrictedFunctionalAppendSamplingEquiv A phi v hv B w hw)]
end

end PvNP.RealizableHardness.ActualBinaryMatrixHC46A18QuotientSamplingLaw
