  (f : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n d → ℝ)
  (K : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n d) :
  PvNP.RealizableHardness.BinaryMatrixFourier.fourierCoeff (fun M => f M ^ 2) K =
