n d s : ℕ
η : ℝ
f : BinaryMatrix n d → ℂ
hf : UpToActualNormSqGlobal s η f
Q : ActualAffineRestriction n d
hQ : Q.order ≤ s + 1
phi : ↥Q.domainFixed →ₗ[ZMod 2] ZMod 2
v : ↥Q.domainFixed
hv : phi v = 1
hsource : ∃ s phi₀,
  have q := Submodule.factor ⋯;
  q ∘ₗ s = LinearMap.id ∧
    q ((functionalKernelInAmbient Q.domainFixed phi).mkQ ↑v) = 0 ∧
      phi₀ ∘ₗ s = 0 ∧
        phi₀ ((functionalKernelInAmbient Q.domainFixed phi).mkQ ↑v) = 1 ∧
          ∀ (x : (Fin d → ZMod 2) ⧸ functionalKernelInAmbient Q.domainFixed phi),
            x = s (q x) + phi₀ x • (functionalKernelInAmbient Q.domainFixed phi).mkQ ↑v :=
  quotientSectionCoordinates_of_restricted_functional Q.domainFixed phi v hv
sCoord : (Fin d → ZMod 2) ⧸ Q.domainFixed →ₗ[ZMod 2] (Fin d → ZMod 2) ⧸ functionalKernelInAmbient Q.domainFixed phi :=
  Classical.choose hsource
hphiSource : ∃ phi₀,
  have q := Submodule.factor ⋯;
  q ∘ₗ Classical.choose hsource = LinearMap.id ∧
    q ((functionalKernelInAmbient Q.domainFixed phi).mkQ ↑v) = 0 ∧
      phi₀ ∘ₗ Classical.choose hsource = 0 ∧
        phi₀ ((functionalKernelInAmbient Q.domainFixed phi).mkQ ↑v) = 1 ∧
          ∀ (x : (Fin d → ZMod 2) ⧸ functionalKernelInAmbient Q.domainFixed phi),
            x = (Classical.choose hsource) (q x) + phi₀ x • (functionalKernelInAmbient Q.domainFixed phi).mkQ ↑v :=
  Classical.choose_spec hsource
phi₀ : (Fin d → ZMod 2) ⧸ functionalKernelInAmbient Q.domainFixed phi →ₗ[ZMod 2] ZMod 2 := Classical.choose hphiSource
A' : Submodule (ZMod 2) (Fin d → ZMod 2) := functionalKernelInAmbient Q.domainFixed phi
X : Type := (Fin d → ZMod 2) ⧸ Q.domainFixed
X' : Type := (Fin d → ZMod 2) ⧸ A'
