PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.canonical_source_tower_endpoint_collapse {n d r l h : ℕ}
  (A :
    Submodule PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.F✝
      (PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.V✝ d))
  (B :
    Submodule PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.F✝
      (PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.W✝ n))
  (lines : ActualTypedABCanonicalFlag.DomainLineFlag ⊥ l)
  (hypers : ActualTypedABCanonicalFlag.CodomainHyperplaneFlag ⊤ h) (hA : lines.endpoint = A) (hB : hypers.endpoint = B)
  (T :
    PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.V✝
        d →ₗ[PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.F✝]
      PvNP.RealizableHardness.ActualTypedABCanonicalEndpointCollapse.W✝ n)
  (ambientf : BinaryMatrixFourier.BinaryMatrix n d → ℂ) :
  have source := fun M => ActualTypedABCanonicalDCollapse.filteredCarrierFunction ⊥ ⊤ 0 ambientf M;
  have base := ⊤.subtype ∘ₗ initialBottomTopBase T ∘ₗ ⊥.mkQ;
  let tower := ActualTypedABCanonicalFlag.buildCanonicalSourceTower lines hypers (initialBottomTopBase T);
  have hEnd := ⋯;
  have e := ActualTypedABEndpointTransport.endpointHomEquiv ⋯ ⋯;
  (fun M =>
      ActualTypedABCanonicalProjection.applyCanonicalFilters tower
        (if h + l = 0 then fun N => ActualTypedABCanonicalDCollapse.filteredCarrierFunction ⊥ ⊤ base ambientf N
        else source)
        (e.symm M)) =
    ActualTypedABCanonicalDCollapse.filteredCarrierFunction A B T ambientf
