 Quot.sound]
PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.complexFourierCoeff_character {n d : ℕ}
  (Y Z : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n d) :
  PvNP.RealizableHardness.BinaryMatrixA1Complex.complexFourierCoeff
      (fun M => ↑(PvNP.RealizableHardness.BinaryMatrixFourier.character Y M)) Z =
