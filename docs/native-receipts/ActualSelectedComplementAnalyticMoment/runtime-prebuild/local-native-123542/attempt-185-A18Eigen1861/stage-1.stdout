PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.selected_frequency_rank_eq_carrier_rank_add_cost
  {n d : ℕ}
  (A :
    Submodule PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.F✝
      (PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.V✝ d))
  (B :
    Submodule PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.F✝
      (PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.W✝ n))
  (Y : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n d)
  (hsel : PvNP.RealizableHardness.BinaryMatrixNestedSelectorA1.Selected A B (Matrix.toLin' (Matrix.transpose Y))) :
  Matrix.rank Y =
    Module.finrank PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.F✝ ↥A +
        Module.finrank PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.F✝
          (PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.W✝ n ⧸ B) +
      Module.finrank PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.F✝
        ↥(PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.selectedCarrierFrequency✝ A B
              Y).range
