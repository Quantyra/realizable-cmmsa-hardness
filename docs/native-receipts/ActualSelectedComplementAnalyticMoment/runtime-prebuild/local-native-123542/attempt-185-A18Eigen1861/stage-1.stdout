  (T :
    PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.V✝
        d →ₗ[PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.F✝]
      PvNP.RealizableHardness.ActualBinaryMatrixHC46A18DerivativeRankProjection.W✝ n)
  (Y : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n d)
  (M :
