      PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.W✝ n)
  (f : BinaryMatrixFourier.BinaryMatrix n d → ℂ)
  (Z :
    ↥(Matrix.toLin' (Matrix.transpose X)).ker →ₗ[PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.F✝]
      PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.V✝ d ⧸
        (Matrix.toLin' (Matrix.transpose X)).range) :
  BinaryMatrixA1Complex.complexCarrierFourierCoeff (Matrix.toLin' (Matrix.transpose X)).range
      (Matrix.toLin' (Matrix.transpose X)).ker (actualW6Derivative X T f) Z =
    ∑ Y,
      if w6Precedes X Y then
        if
            Z =
              (Matrix.toLin' (Matrix.transpose X)).range.mkQ ∘ₗ
                Matrix.toLin' (Matrix.transpose Y) ∘ₗ (Matrix.toLin' (Matrix.transpose X)).ker.subtype then
          BinaryMatrixA1Complex.complexFourierCoeff f Y *
            ↑(BinaryMatrixA1Phase.traceCharacter (Matrix.toLin' (Matrix.transpose Y)) T)
        else 0
      else 0
