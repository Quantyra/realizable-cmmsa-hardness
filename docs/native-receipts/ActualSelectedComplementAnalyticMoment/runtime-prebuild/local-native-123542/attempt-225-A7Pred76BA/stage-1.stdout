PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.actualW6Derivative_fourier_expansion {n d : ℕ}
  (X : BinaryMatrixFourier.BinaryMatrix n d)
  (T :
    PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.V✝
        d →ₗ[PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.F✝]
      PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.W✝ n)
  (f : BinaryMatrixFourier.BinaryMatrix n d → ℂ)
  (M :
    PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor.V✝ d ⧸
