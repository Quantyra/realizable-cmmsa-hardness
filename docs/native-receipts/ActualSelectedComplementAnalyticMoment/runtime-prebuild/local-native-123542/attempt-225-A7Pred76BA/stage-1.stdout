      ↥(Matrix.toLin' (Matrix.transpose X)).ker) :
  actualW6Derivative X T f M =
    ∑ Y,
      if w6Precedes X Y then
        BinaryMatrixA1Complex.complexFourierCoeff f Y *
          ↑(BinaryMatrixFourier.character Y
              (LinearMap.toMatrix'
                (T +
                  (Matrix.toLin' (Matrix.transpose X)).ker.subtype ∘ₗ
                    M ∘ₗ (Matrix.toLin' (Matrix.transpose X)).range.mkQ)))
      else 0
