      PvNP.RealizableHardness.ActualTypedCarrierAmbientBudget.W✝ n)
  (Q : PvNP.RealizableHardness.BinaryMatrixTypedA15Transport.CarrierRestriction A B)
  (M :
    PvNP.RealizableHardness.ActualTypedCarrierAmbientBudget.V✝ d ⧸
