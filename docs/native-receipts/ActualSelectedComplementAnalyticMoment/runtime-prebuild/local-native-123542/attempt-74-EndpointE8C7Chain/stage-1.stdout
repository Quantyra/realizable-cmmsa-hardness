  (tower : ActualTypedABRankedTower.ActualTypedABRankedTower A₀ B₀ f r k)
  (hA : (ActualTypedABRankedTower.rankedTerminalData tower).Aend = A₁)
  (hB : (ActualTypedABRankedTower.rankedTerminalData tower).Bend = B₁) (hlevel : r + k ≤ D) (eps : ℝ) (heps : 0 ≤ eps)
  (hglobal : BinaryMatrixTypedA15Transport.UpToTypedNormSqGlobal A₀ B₀ (r + k) eps f) :
