case pos
n d : ℕ
A : Submodule (ZMod 2) (Fin d → ZMod 2)
B : Submodule (ZMod 2) (Fin n → ZMod 2)
f : BinaryMatrix n d → ℂ
M : (Fin d → ZMod 2) ⧸ A →ₗ[ZMod 2] ↥B
Y : BinaryMatrix n d
hfun : (fun T => filteredCarrierFunction A B (Matrix.toLin' T) f M) = fun T => ∑ Z, affineBaseFourierTerm A B f M Z T
hs : Selected A B (Matrix.toLin' (Matrix.transpose Y))
⊢ (∑ x,
      if Selected A B (Matrix.toLin' (Matrix.transpose x)) then
        if Y = x then
          complexFourierCoeff f x * ↑(traceCharacter (A.mkQ ∘ₗ Matrix.toLin' (Matrix.transpose x) ∘ₗ B.subtype) M)
        else 0
      else 0) =
    complexFourierCoeff f Y * ↑(traceCharacter (A.mkQ ∘ₗ Matrix.toLin' (Matrix.transpose Y) ∘ₗ B.subtype) M)
