PvNP.RealizableHardness.ActualBinaryMatrixHC46A18FullFunctionalBridge.globalFunctionalRow_average_reindex {n d : ℕ}
  (A : Submodule (ZMod 2) (Fin d → ZMod 2)) (v : ↥A) (g : FunctionalsAt ↑v × (Fin n → ZMod 2) → ℂ)
  (g' : RestrictedFunctionals A v × ((Fin d → ZMod 2) ⧸ A →ₗ[ZMod 2] ZMod 2) × (Fin n → ZMod 2) → ℂ)
  (hpoint : ∀ (p : FunctionalsAt ↑v × (Fin n → ZMod 2)), g p = g' ((globalFunctionalRowEquiv A v) p)) :
