PvNP.RealizableHardness.ActualBinaryMatrixHC46A18FullFunctionalBridge.actualA18_sourceSample_eq_ambient {n d : ℕ}
  (Q : PvNP.RealizableHardness.BinaryMatrixActualAffine.ActualAffineRestriction n d)
  (phi : ↥Q.domainFixed →ₗ[ZMod 2] ZMod 2) (v : ↥Q.domainFixed) (hv : phi v = 1)
  (R : (Fin d → ZMod 2) ⧸ Q.domainFixed →ₗ[ZMod 2] ↥Q.codomainVariation)
  (lambda : (Fin d → ZMod 2) ⧸ Q.domainFixed →ₗ[ZMod 2] ZMod 2) (w : Fin n → ZMod 2) :
  let A' :=
    PvNP.RealizableHardness.ActualBinaryMatrixHC46A18QuotientSamplingLaw.functionalKernelInAmbient Q.domainFixed phi;
  have qdom := Submodule.factor ⋯;
  have hcoords := ⋯;
  have phi₀ := Classical.choose ⋯;
  have psi :=
    (PvNP.RealizableHardness.ActualBinaryMatrixHC46A18SourceGlobal.restrictedFunctionalExtensionEquiv Q.domainFixed phi
        v hv)
      lambda;
  LinearMap.toMatrix'
      (Matrix.toLin' Q.base +
        PvNP.RealizableHardness.ActualBinaryMatrixHC46A18QuotientSamplingLaw.quotientSampleOutput Q.codomainVariation
            qdom phi₀ R lambda w ∘ₗ
          A'.mkQ) =
    LinearMap.toMatrix' (Matrix.toLin' Q.base + Q.codomainVariation.subtype ∘ₗ R ∘ₗ Q.domainFixed.mkQ) +
      actualA18RankOne (↑psi) w
