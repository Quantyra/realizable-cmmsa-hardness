  {X : Type u_1} {W : Type u_2} [AddCommGroup X] [Module (ZMod 2) X] [AddCommGroup W] [Module (ZMod 2) W] [Fintype X]
  [Fintype W] (B B' : Submodule (ZMod 2) W) (hB : B ≤ B')
  (hdim : Module.finrank (ZMod 2) ↥B' = Module.finrank (ZMod 2) ↥B + 1) (C : Type u_3) [Fintype C] [Nonempty C]
  (gStable : (_ : ↥B) × C → ℝ) (gExpanded : (_ : { w // ↑w ∉ B }) × C → ℝ) {η : ℝ} (hη : 0 ≤ η)
  (hStable : (∑ p, gStable p) / ↑(Fintype.card ((_ : ↥B) × C)) ≤ η)
  (hExpanded : (∑ p, gExpanded p) / ↑(Fintype.card ((_ : { w // ↑w ∉ B }) × C)) ≤ 2 * η) :
  (∑ p, Sum.elim gStable gExpanded p) / ↑(Fintype.card ((_ : ↥B) × C ⊕ (_ : { w // ↑w ∉ B }) × C)) ≤ 2 * η
