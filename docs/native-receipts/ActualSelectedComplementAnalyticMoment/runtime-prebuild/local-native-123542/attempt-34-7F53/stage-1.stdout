PvNP.RealizableHardness.ActualBinaryMatrixHC46A18SourceGlobal.actual_A18_source_branch_mixture_energy_le_two {n d s : ℕ}
  {η : ℝ} (f : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n d → ℂ)
  (hf : PvNP.RealizableHardness.BinaryMatrixComplexA15.UpToActualNormSqGlobal s η f)
  (Q : PvNP.RealizableHardness.BinaryMatrixActualAffine.ActualAffineRestriction n d) (hQ : Q.order ≤ s + 1)
  (phi : ↥Q.domainFixed →ₗ[ZMod 2] ZMod 2) (v : ↥Q.domainFixed) (hv : phi v = 1)
  (B' : Submodule (ZMod 2) (Fin n → ZMod 2)) (hB : Q.codomainVariation ≤ B')
  (hdim : Module.finrank (ZMod 2) ↥B' = Module.finrank (ZMod 2) ↥Q.codomainVariation + 1) :
  let A' :=
    PvNP.RealizableHardness.ActualBinaryMatrixHC46A18QuotientSamplingLaw.functionalKernelInAmbient Q.domainFixed phi;
  let X0 := Fin d → ZMod 2;
  let X := X0 ⧸ Q.domainFixed;
  let X' := X0 ⧸ A';
  have q := Submodule.factor ⋯;
  ∃ sCoord phi₀,
    q ∘ₗ sCoord = LinearMap.id ∧
      q (A'.mkQ ↑v) = 0 ∧
        phi₀ ∘ₗ sCoord = 0 ∧
          phi₀ (A'.mkQ ↑v) = 1 ∧
            (∀ (x : X'), x = sCoord (q x) + phi₀ x • A'.mkQ ↑v) ∧
              let C := (X →ₗ[ZMod 2] ↥Q.codomainVariation) × (X →ₗ[ZMod 2] ZMod 2);
              let Stable := (_ : ↥Q.codomainVariation) × C;
              let Outside := { w // ↑w ∉ Q.codomainVariation };
              let Expanded := (_ : Outside) × C;
              let QStable := { domainFixed := A', codomainVariation := Q.codomainVariation, base := Q.base };
              let QExpanded := { domainFixed := A', codomainVariation := B', base := Q.base };
              (∑ p,
                    Sum.elim
                      (fun p =>
                        Complex.normSq
                          (f
                            ↑((PvNP.RealizableHardness.ActualBinaryMatrixHC46ActualFibreModel.actualFibreQuotientHomEquiv
                                    QStable).symm
                                (stableSourceSampleMap Q.codomainVariation q phi₀ p.snd.1 p.snd.2 p.fst))))
                      (fun p =>
                        Complex.normSq
                          (f
                            ↑((PvNP.RealizableHardness.ActualBinaryMatrixHC46ActualFibreModel.actualFibreQuotientHomEquiv
                                    QExpanded).symm
                                ↑((actual_expanded_source_coordinates_equiv Q.domainFixed phi v hv Q.codomainVariation
                                      B' hB hdim)
                                    p))))
                      p) /
                  ↑(Fintype.card (Stable ⊕ Expanded)) ≤
                2 * η
