  ∃ phi₀ sCoord,
    q ∘ₗ sCoord = LinearMap.id ∧
      q (A'.mkQ ↑v) = 0 ∧
        phi₀ ∘ₗ sCoord = 0 ∧
          phi₀ (A'.mkQ ↑v) = 1 ∧
            (∀ (x : X ⧸ A'), x = sCoord (q x) + phi₀ x • A'.mkQ ↑v) ∧
