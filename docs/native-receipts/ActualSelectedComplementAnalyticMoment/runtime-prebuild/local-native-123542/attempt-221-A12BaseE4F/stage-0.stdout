n d : ℕ
A : Submodule (ZMod 2) (Fin d → ZMod 2)
B : Submodule (ZMod 2) (Fin n → ZMod 2)
f : BinaryMatrix n d → ℂ
S : ℝ := ∑ Y, if Selected A B (Matrix.toLin' (Matrix.transpose Y)) then Complex.normSq (complexFourierCoeff f Y) else 0
NT : ℝ := ↑(Fintype.card (BinaryMatrix n d))
NM : ℝ := ↑(Fintype.card ((Fin d → ZMod 2) ⧸ A →ₗ[ZMod 2] ↥B))
hNT : NT ≠ 0
hNM : NM ≠ 0
hpoint :
  ∀ (M : (Fin d → ZMod 2) ⧸ A →ₗ[ZMod 2] ↥B),
    ∑ T, Complex.normSq (filteredCarrierFunction A B (Matrix.toLin' T) f M) = NT * S
hdouble : ∑ T, ∑ M, Complex.normSq (filteredCarrierFunction A B (Matrix.toLin' T) f M) = NT * ∑ M, S
hconst : ∑ M, S = NM * S
⊢ ∑ i, (∑ M, Complex.normSq (filteredCarrierFunction A B (Matrix.toLin' i) f M)) / NM / NT = S
