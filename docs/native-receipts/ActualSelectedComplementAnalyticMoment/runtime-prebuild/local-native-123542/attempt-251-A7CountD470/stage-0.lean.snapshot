import PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor
import PvNP.RealizableHardness.ActualTypedABBottomTopRankReindex
import Mathlib.LinearAlgebra.Projection
import Mathlib.LinearAlgebra.Isomorphisms

/-! Rank-additive predecessors at a fixed frequency.  This module starts the
actual matrix-to-projection adapter used by the W6 predecessor count; it does
not import the uncompiled GrassmannCounting draft. -/

namespace PvNP.RealizableHardness.ActualBinaryMatrixHC46A7PredecessorCount

open PvNP.RealizableHardness.ActualBinaryMatrixHC46A7WeightedPredecessor
open PvNP.RealizableHardness.ActualTypedABBottomTopRankReindex
open PvNP.RealizableHardness.BinaryMatrixFourier
open scoped BigOperators

set_option autoImplicit false
noncomputable section
attribute [local instance] Classical.propDecidable
attribute [local instance] Fintype.ofFinite

private abbrev F := ZMod 2
private abbrev V (d : Nat) := Fin d → F
private abbrev W (n : Nat) := Fin n → F

/-- The transposed linear map represented by a matrix in the manuscript's
`W n → V d` convention. -/
def transposeMap {n d : Nat} (M : BinaryMatrix n d) : W n →ₗ[F] V d :=
  M.transpose.toLin'

private theorem transposeMap_rank {n d : Nat} (M : BinaryMatrix n d) :
    Module.finrank F (LinearMap.range (transposeMap M)) = M.rank := by
  change Module.finrank F (LinearMap.range M.transpose.toLin') = M.rank
  rw [← Matrix.rank_transpose M]
  rw [Matrix.rank_eq_finrank_range_toLin M.transpose
    (Pi.basisFun F _) (Pi.basisFun F _)]
  rw [Matrix.toLin_eq_toLin']

/-- Rank additivity makes the two transposed image subspaces disjoint and
their sum exactly the image of the parent map.  The map direction is
`W n → V d`, since `M.transpose.toLin'` is the represented map. -/
theorem w6_predecessor_range_decomposition {n d : Nat}
    (X Y : BinaryMatrix n d) (hXY : w6Precedes X Y) :
    LinearMap.range (transposeMap X) ⊓
        LinearMap.range (transposeMap (Y - X)) = ⊥ ∧
      LinearMap.range (transposeMap X) ⊔
        LinearMap.range (transposeMap (Y - X)) =
          LinearMap.range (transposeMap Y) := by
  let LX := transposeMap X
  let LY := transposeMap Y
  let LZ := transposeMap (Y - X)
  have hsum : LY = LX + LZ := by
    ext v i
    simp [LY, LX, LZ, transposeMap, Matrix.toLin'_apply,
      Matrix.transpose_sub, Matrix.sub_apply]
  have hRle : LinearMap.range LY ≤
      LinearMap.range LX ⊔ LinearMap.range LZ := by
    have hleft : LinearMap.range LX ≤
        LinearMap.range LX ⊔ LinearMap.range LZ := le_sup_left
    have hright : LinearMap.range LZ ≤
        LinearMap.range LX ⊔ LinearMap.range LZ := le_sup_right
    intro z hz
    rcases hz with ⟨v, rfl⟩
    rw [hsum]
    change LX v + LZ v ∈ LinearMap.range LX ⊔ LinearMap.range LZ
    apply add_mem
    · exact hleft (LinearMap.mem_range_self LX v)
    · exact hright (LinearMap.mem_range_self LZ v)
  have hdim : Module.finrank F ↥(LinearMap.range LY) =
      Module.finrank F ↥(LinearMap.range LX) +
        Module.finrank F ↥(LinearMap.range LZ) := by
    rw [transposeMap_rank, transposeMap_rank, transposeMap_rank]
    exact hXY
  have hsup_le : Module.finrank F
      ↥(LinearMap.range LX ⊔ LinearMap.range LZ) ≤
        Module.finrank F ↥(LinearMap.range LX) +
          Module.finrank F ↥(LinearMap.range LZ) := by
    have h := Submodule.finrank_sup_add_finrank_inf_eq
      (LinearMap.range LX) (LinearMap.range LZ)
    omega
  have hsup_dim : Module.finrank F
      ↥(LinearMap.range LX ⊔ LinearMap.range LZ) =
        Module.finrank F ↥(LinearMap.range LY) := by
    have hmono := Submodule.finrank_mono hRle
    omega
  have hsum_eq : LinearMap.range LY =
      LinearMap.range LX ⊔ LinearMap.range LZ :=
    Submodule.eq_of_le_of_finrank_eq hRle hsup_dim.symm
  have hinf_dim : Module.finrank F
      ↥(LinearMap.range LX ⊓ LinearMap.range LZ) = 0 := by
    have h := Submodule.finrank_sup_add_finrank_inf_eq
      (LinearMap.range LX) (LinearMap.range LZ)
    rw [hsup_dim] at h
    omega
  have hinf : LinearMap.range LX ⊓ LinearMap.range LZ = ⊥ :=
    (Submodule.finrank_eq_zero).mp hinf_dim
  exact ⟨hinf, hsum_eq.symm⟩

/-- The parent's kernel is contained in the predecessor's kernel.  This is
the well-definedness fact needed to descend `Xᵀ` to `range(Yᵀ)`. -/
theorem w6_predecessor_ker_le {n d : Nat}
    (X Y : BinaryMatrix n d) (hXY : w6Precedes X Y) :
    LinearMap.ker (transposeMap Y) ≤ LinearMap.ker (transposeMap X) := by
  have hsum : transposeMap Y = transposeMap X + transposeMap (Y - X) := by
    ext v i
    simp [transposeMap, Matrix.toLin'_apply, Matrix.transpose_sub,
      Matrix.sub_apply]
  have hdisj := (w6_predecessor_range_decomposition X Y hXY).1
  intro v hv
  apply LinearMap.mem_ker.mpr
  have hzero := LinearMap.mem_ker.mp hv
  have hparts : transposeMap X v = -(transposeMap (Y - X) v) := by
    have := congrArg (fun z : V d => z) (hzero)
    rw [hsum, LinearMap.add_apply] at this
    exact (eq_neg_iff_add_eq_zero).2 this
  have hx : transposeMap X v ∈ LinearMap.range (transposeMap X) :=
    LinearMap.mem_range_self (transposeMap X) v
  have hz : -(transposeMap (Y - X) v) ∈ LinearMap.range (transposeMap (Y - X)) :=
    (LinearMap.range (transposeMap (Y - X))).neg_mem
      (LinearMap.mem_range_self (transposeMap (Y - X)) v)
  have hboth : transposeMap X v ∈
      LinearMap.range (transposeMap X) ⊓ LinearMap.range (transposeMap (Y - X)) :=
    ⟨hx, by rw [hparts]; exact hz⟩
  have hbot : transposeMap X v = 0 := by
    have hm := hboth
    rw [hdisj] at hm
    simpa using hm
  exact hbot

private theorem w6_predecessor_range_le_parent {n d : Nat}
    (X Y : BinaryMatrix n d) (hXY : w6Precedes X Y) :
    LinearMap.range (transposeMap X) ≤ LinearMap.range (transposeMap Y) := by
  rw [← (w6_predecessor_range_decomposition X Y hXY).2]
  exact le_sup_left

/-- The predecessor map, with its codomain restricted to the parent's image.
This proof-level definition has no containment premise: that fact follows
from rank additivity. -/
def w6PredecessorRestrictedMap {n d : Nat}
    (X Y : BinaryMatrix n d) (hXY : w6Precedes X Y) :
    W n →ₗ[F] LinearMap.range (transposeMap Y) :=
  (transposeMap X).codRestrict (LinearMap.range (transposeMap Y))
    (fun v => w6_predecessor_range_le_parent X Y hXY
      (LinearMap.mem_range_self (transposeMap X) v))

/-- Every rank-additive predecessor descends uniquely to an idempotent on the
parent image. Its range rank is the predecessor rank, and all facts are
derived from `w6Precedes`; no factorization or idempotence is a premise. -/
theorem w6_predecessor_descended_idempotent {n d : Nat}
    (X Y : BinaryMatrix n d) (hXY : w6Precedes X Y) :
    ∃! q : Module.End F (LinearMap.range (transposeMap Y)),
      IsIdempotentElem q ∧
        Module.finrank F (LinearMap.range q) = X.rank ∧
        q.comp (LinearMap.rangeRestrict (transposeMap Y)) =
          w6PredecessorRestrictedMap X Y hXY := by
  classical
  let LX : W n →ₗ[F] V d := transposeMap X
  let LY : W n →ₗ[F] V d := transposeMap Y
  let LZ : W n →ₗ[F] V d := transposeMap (Y - X)
  let E : Submodule F (V d) := LinearMap.range LY
  let g : W n →ₗ[F] E := LinearMap.rangeRestrict LY
  let f : W n →ₗ[F] E := w6PredecessorRestrictedMap X Y hXY
  have hsum : LY = LX + LZ := by
    ext v i
    simp [LY, LX, LZ, transposeMap, Matrix.toLin'_apply,
      Matrix.transpose_sub, Matrix.sub_apply]
  have hsurj : Function.Surjective g := by
    intro z
    rcases z with ⟨z, hz⟩
    rcases hz with ⟨v, rfl⟩
    exact ⟨v, rfl⟩
  have hker : LinearMap.ker g ≤ LinearMap.ker f := by
    intro v hv
    apply LinearMap.mem_ker.mpr
    apply Subtype.ext
    have hYzero : LY v = 0 := by
      have h := congrArg Subtype.val (LinearMap.mem_ker.mp hv)
      exact h
    have hXzero := LinearMap.mem_ker.mp
      (w6_predecessor_ker_le X Y hXY (LinearMap.mem_ker.mpr hYzero))
    exact hXzero
  let e := g.quotKerEquivOfSurjective hsurj
  let qbar := (LinearMap.ker g).liftQ f hker
  let q : Module.End F E := qbar.comp e.symm.toLinearMap
  have hfactor : q.comp g = f := by
    apply LinearMap.ext
    intro v
    change q (g v) = f v
    dsimp [q, qbar, e]
    rw [LinearMap.quotKerEquivOfSurjective_symm_apply]
    rfl
  have hfix : ∀ z : E, z ∈ LinearMap.range f → q z = z := by
    intro z hz
    rcases hz with ⟨x, rfl⟩
    obtain ⟨y, hy⟩ := hsurj (f x)
    have hLYX : LY y = LX x := by
      have h₁ := congrArg Subtype.val hy
      have h₂ : (f x : V d) = LX x := rfl
      exact h₁.trans h₂
    have hparts : LX x - LX y = LZ y := by
      rw [← hLYX, hsum, LinearMap.add_apply]
      abel
    have hmemX : LX x - LX y ∈ LinearMap.range LX :=
      Submodule.sub_mem _ (LinearMap.mem_range_self LX x)
        (LinearMap.mem_range_self LX y)
    have hmemZ : LX x - LX y ∈ LinearMap.range LZ := by
      rw [hparts]
      exact LinearMap.mem_range_self LZ y
    have hboth : LX x - LX y ∈
        LinearMap.range LX ⊓ LinearMap.range LZ := ⟨hmemX, hmemZ⟩
    have hzero : LX x - LX y = 0 := by
      have hmem : LX x - LX y ∈ (⊥ : Submodule F (V d)) := by
        rw [(w6_predecessor_range_decomposition X Y hXY).1] at hboth
        exact hboth
      simpa using hmem
    have hXYval : LX y = LX x := (sub_eq_zero.mp hzero).symm
    calc
      q (f x) = q (g y) := by rw [hy]
      _ = f y := by
        have h := congrArg (fun L : W n →ₗ[F] E => L y) hfactor
        simpa only [LinearMap.comp_apply] using h
      _ = f x := by
        apply Subtype.ext
        exact hXYval
  have hqrange : LinearMap.range q ≤ LinearMap.range f := by
    rintro z ⟨u, rfl⟩
    obtain ⟨v, hv⟩ := hsurj u
    refine ⟨v, ?_⟩
    have hqu : q u = f v := by
      calc
        q u = q (g v) := by rw [hv]
        _ = f v := by
          have h := congrArg (fun L : W n →ₗ[F] E => L v) hfactor
          simpa only [LinearMap.comp_apply] using h
    exact hqu.symm
  have hrange : LinearMap.range q = LinearMap.range f := by
    apply le_antisymm hqrange
    rintro z ⟨v, rfl⟩
    refine ⟨g v, ?_⟩
    have h := congrArg (fun L : W n →ₗ[F] E => L v) hfactor
    simpa only [LinearMap.comp_apply] using h
  have hIdem : IsIdempotentElem q := by
    apply LinearMap.ext
    intro z
    change q (q z) = q z
    apply hfix
    exact hqrange (LinearMap.mem_range_self q z)
  have hfrange : Module.finrank F (LinearMap.range f) = X.rank := by
    have hcomp : E.subtype.comp f = LX := by
      ext v
      rfl
    have hmap : (LinearMap.range f).map E.subtype = LinearMap.range LX := by
      rw [← LinearMap.range_comp, hcomp]
    rw [← Submodule.finrank_map_subtype_eq E (LinearMap.range f), hmap,
      transposeMap_rank]
  have hqrank : Module.finrank F (LinearMap.range q) = X.rank := by
    rw [hrange, hfrange]
  refine ⟨q, ⟨hIdem, hqrank, hfactor⟩, ?_⟩
  intro q' hq'
  rcases hq' with ⟨_, _, hfactor'⟩
  apply LinearMap.ext
  intro z
  obtain ⟨v, hv⟩ := hsurj z
  calc
    q' z = q' (g v) := by rw [hv]
    _ = f v := by
      have h := congrArg (fun L : W n →ₗ[F] E => L v) hfactor'
      simpa only [LinearMap.comp_apply] using h
    _ = q (g v) := by
      have h := congrArg (fun L : W n →ₗ[F] E => L v) hfactor
      simpa only [LinearMap.comp_apply] using h.symm
    _ = q z := by rw [hv]

/-- The transpose-map realization of an endomorphism of the parent's image.
This is the converse construction: restrict `Yᵀ` to its image, apply the
idempotent, and include the result back into the ambient coordinate space. -/
def w6IdempotentLiftMap {n d : Nat} (Y : BinaryMatrix n d)
    (q : Module.End F (LinearMap.range (transposeMap Y))) :
    W n →ₗ[F] V d :=
  (LinearMap.range (transposeMap Y)).subtype.comp
    (q.comp (LinearMap.rangeRestrict (transposeMap Y)))

/-- Convert a linear map `W n → V d` back to the manuscript's `n × d`
matrix convention. -/
def w6IdempotentPredecessorMatrix {n d : Nat} (Y : BinaryMatrix n d)
    (q : Module.End F (LinearMap.range (transposeMap Y))) : BinaryMatrix n d :=
  (LinearMap.toMatrix' (w6IdempotentLiftMap Y q)).transpose

private theorem transposeMap_w6IdempotentPredecessorMatrix {n d : Nat}
    (Y : BinaryMatrix n d)
    (q : Module.End F (LinearMap.range (transposeMap Y))) :
    transposeMap (w6IdempotentPredecessorMatrix Y q) =
      w6IdempotentLiftMap Y q := by
  simp [transposeMap, w6IdempotentPredecessorMatrix,
    Matrix.transpose_transpose, Matrix.toLin'_toMatrix']

/-- Every idempotent on the parent image gives an actual rank-additive
predecessor. The rank identity is part of the conclusion, so this is a
genuine converse to the descended-idempotent construction. -/
theorem w6_idempotent_gives_predecessor {n d : Nat}
    (Y : BinaryMatrix n d)
    (q : Module.End F (LinearMap.range (transposeMap Y)))
    (hq : IsIdempotentElem q) :
    w6Precedes (w6IdempotentPredecessorMatrix Y q) Y ∧
      (w6IdempotentPredecessorMatrix Y q).rank =
        Module.finrank F (LinearMap.range q) := by
  classical
  let LY : W n →ₗ[F] V d := transposeMap Y
  let E : Submodule F (V d) := LinearMap.range LY
  let g : W n →ₗ[F] E := LinearMap.rangeRestrict LY
  let p : Module.End F E := LinearMap.id - q
  let X : BinaryMatrix n d := w6IdempotentPredecessorMatrix Y q
  let LX : W n →ₗ[F] V d := transposeMap X
  let LZ : W n →ₗ[F] V d := transposeMap (Y - X)
  have hsurj : Function.Surjective g := by
    intro z
    rcases z with ⟨z, hz⟩
    rcases hz with ⟨v, rfl⟩
    exact ⟨v, rfl⟩
  have hqfun : ∀ z : E, q (q z) = q z := by
    intro z
    have h := congrArg (fun r : Module.End F E => r z) hq
    simpa [IsIdempotentElem, Module.End.mul_apply] using h
  have hqp : q.comp p = 0 := by
    apply LinearMap.ext
    intro z
    simp [p, LinearMap.sub_apply, hqfun z]
  have hpq : q + p = LinearMap.id := by
    apply LinearMap.ext
    intro z
    simp [p, LinearMap.sub_apply, LinearMap.add_apply]
  have hsup : LinearMap.range q ⊔ LinearMap.range p = ⊤ := by
    apply le_antisymm le_top
    intro z hz
    have hzsum : z = q z + p z := by
      have hzid := congrArg (fun r : Module.End F E => r z) hpq
      simpa only [LinearMap.add_apply, LinearMap.id_apply] using hzid.symm
    rw [hzsum]
    have hqmem : q z ∈ LinearMap.range q :=
      LinearMap.mem_range_self q z
    have hpmem : p z ∈ LinearMap.range p :=
      LinearMap.mem_range_self p z
    have hleft : LinearMap.range q ≤ LinearMap.range q ⊔ LinearMap.range p :=
      le_sup_left
    have hright : LinearMap.range p ≤ LinearMap.range q ⊔ LinearMap.range p :=
      le_sup_right
    exact add_mem (hleft hqmem) (hright hpmem)
  have hinf : LinearMap.range q ⊓ LinearMap.range p = ⊥ := by
    apply le_antisymm
    · intro z hz
      change z = 0
      rcases hz.1 with ⟨u, rfl⟩
      rcases hz.2 with ⟨v, hv⟩
      have hqfix : q (q u) = q u := hqfun u
      have hqzero : q (p v) = 0 := by
        have h := congrArg (fun r : Module.End F E => r v) hqp
        simpa only [LinearMap.comp_apply, LinearMap.zero_apply] using h
      calc
        q u = q (q u) := hqfix.symm
        _ = q (p v) := (congrArg q hv).symm
        _ = 0 := hqzero
    · exact bot_le
  have hdim : Module.finrank F E =
      Module.finrank F (LinearMap.range q) +
        Module.finrank F (LinearMap.range p) := by
    have h := Submodule.finrank_sup_add_finrank_inf_eq
      (LinearMap.range q) (LinearMap.range p)
    rw [hsup, hinf] at h
    simpa using h
  have hX : LX = E.subtype.comp (q.comp g) := by
    dsimp [LX, X, w6IdempotentPredecessorMatrix, w6IdempotentLiftMap,
      LY, E, g]
    simp [transposeMap, Matrix.transpose_transpose,
      Matrix.toLin'_toMatrix'] <;> rfl
  have hY : LY = E.subtype.comp g := by
    apply LinearMap.ext
    intro v
    rfl
  have hLZ : LZ = E.subtype.comp (p.comp g) := by
    have hsum : LY = LX + LZ := by
      apply LinearMap.ext
      intro v
      ext i
      simp [LY, LX, LZ, transposeMap, Matrix.toLin'_apply,
        Matrix.transpose_sub, Matrix.sub_apply]
    have htarget : LX + E.subtype.comp (p.comp g) = LY := by
      rw [hX, hY]
      apply LinearMap.ext
      intro v
      simp [p, LinearMap.sub_apply, LinearMap.add_apply,
        LinearMap.comp_apply]
    calc
      LZ = LY - LX := by rw [hsum]; abel
      _ = E.subtype.comp (p.comp g) := by rw [← htarget]; abel
  have hqg : LinearMap.range (q.comp g) = LinearMap.range q := by
    apply le_antisymm
    · rintro z ⟨v, rfl⟩
      exact ⟨g v, rfl⟩
    · rintro z ⟨u, rfl⟩
      obtain ⟨v, hv⟩ := hsurj u
      refine ⟨v, ?_⟩
      have h := congrArg q hv
      simpa only [LinearMap.comp_apply] using h
  have hpg : LinearMap.range (p.comp g) = LinearMap.range p := by
    apply le_antisymm
    · rintro z ⟨v, rfl⟩
      exact ⟨g v, rfl⟩
    · rintro z ⟨u, rfl⟩
      obtain ⟨v, hv⟩ := hsurj u
      refine ⟨v, ?_⟩
      have h := congrArg p hv
      simpa only [LinearMap.comp_apply] using h
  have hXrange : LinearMap.range LX =
      (LinearMap.range q).map E.subtype := by
    rw [hX, LinearMap.range_comp, hqg]
  have hZrange : LinearMap.range LZ =
      (LinearMap.range p).map E.subtype := by
    rw [hLZ, LinearMap.range_comp, hpg]
  have hXrank : X.rank = Module.finrank F (LinearMap.range q) := by
    rw [← transposeMap_rank X, hXrange, Submodule.finrank_map_subtype_eq]
  have hZrank : (Y - X).rank = Module.finrank F (LinearMap.range p) := by
    rw [← transposeMap_rank (Y - X), hZrange,
      Submodule.finrank_map_subtype_eq]
  have hYrank : Y.rank = Module.finrank F E := by
    rw [← transposeMap_rank Y]
  constructor
  · unfold w6Precedes
    rw [hYrank, hXrank, hZrank]
    exact hdim
  · exact hXrank

end
end PvNP.RealizableHardness.ActualBinaryMatrixHC46A7PredecessorCount
