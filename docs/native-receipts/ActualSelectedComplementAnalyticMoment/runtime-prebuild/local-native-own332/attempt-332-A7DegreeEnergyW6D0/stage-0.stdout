PredOfY : BinaryMatrix n d → Type := fun Y => { X // w6Precedes X Y }
PairX : Type := (X : BinaryMatrix n d) × PredOfX X
PairY : Type := (Y : BinaryMatrix n d) × PredOfY Y
swap : PairX ≃ PairY :=
