  (A : Submodule (ZMod 2) (Fin d → ZMod 2)) (B : Submodule (ZMod 2) (Fin n → ZMod 2))
  (L : Submodule (ZMod 2) ((Fin d → ZMod 2) ⧸ A)) (hL : Module.finrank (ZMod 2) ↥L = 1)
  (T : (Fin d → ZMod 2) ⧸ A →ₗ[ZMod 2] ↥B) (f : ((Fin d → ZMod 2) ⧸ A →ₗ[ZMod 2] ↥B) → ℂ) (hε : 0 ≤ ε)
  (hf : UpToTypedNormSqGlobal A B (k + 1) ε f) :
  (UpToActualNormSqGlobal k (4 * 2 ^ (4 * (k + 1)) * ε) fun X =>
      typedLineP B L hL k f ((lineMatrixEquiv B L hL).symm (rawLastColumn X (lineBaseColumn B L hL T)))) ∧
    ∀ (N : ((Fin d → ZMod 2) ⧸ A) ⧸ L →ₗ[ZMod 2] ↥B),
