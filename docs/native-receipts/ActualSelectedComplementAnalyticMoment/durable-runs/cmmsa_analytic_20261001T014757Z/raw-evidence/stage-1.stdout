      PvNP.RealizableHardness.BinaryMatrixA1Composition.W✝ n)
  (S :
    PvNP.RealizableHardness.BinaryMatrixA1Composition.V✝ d ⧸ A₂ →ₗ[PvNP.RealizableHardness.BinaryMatrixA1Composition.F✝]
      ↥B₂)
  (f : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n d → ℝ)
  (N :
    (PvNP.RealizableHardness.BinaryMatrixA1Composition.V✝ d ⧸ A₂) ⧸
        Submodule.map A₂.mkQ A₁ →ₗ[PvNP.RealizableHardness.BinaryMatrixA1Composition.F✝]
      ↥(Submodule.comap B₂.subtype B₁)) :
  carrierAffineRestrict A₂ B₂ (Submodule.map A₂.mkQ A₁) (Submodule.comap B₂.subtype B₁) S
      (carrierHybridFilter A₂ B₂ (Submodule.map A₂.mkQ A₁) (Submodule.comap B₂.subtype B₁) fun M =>
        ambientAffineRestrict A₂ B₂ T (ambientHybridFilter A₂ B₂ f) M)
      N =
