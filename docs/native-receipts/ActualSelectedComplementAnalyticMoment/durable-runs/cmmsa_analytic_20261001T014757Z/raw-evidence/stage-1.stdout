info: lean/PvNP/RealizableHardness/ActualBinaryMatrixHC46DerivativeChecks.lean:20:0: PvNP.RealizableHardness.BinaryMatrixHybridSelector.rank_eq_drop_add_hybrid_indicator {n d : ℕ}
  (Y : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n (d + 1)) :
  Matrix.rank Y =
    Matrix.rank (dropLastFrequency Y) + if Pi.single (Fin.last d) 1 ∈ (Matrix.transpose Y).mulVecLin.range then 1 else 0
