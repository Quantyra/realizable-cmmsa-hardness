-  · have hy : ψ x ≠ 0 := by
-      intro hy
-      exact hx (hzero.mpr hy)
-    have hφone : φ x = 1 := by
-      fin_cases hval : φ x <;> simp_all
-    have hψone : ψ x = 1 := by
-      fin_cases hval : ψ x <;> simp_all
-    simp [hφone, hψone]
