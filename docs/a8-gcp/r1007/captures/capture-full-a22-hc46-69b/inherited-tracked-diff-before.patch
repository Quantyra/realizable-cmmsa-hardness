-    (hA : A₂ ≤ A₁) (hB : B₁ ≤ B₂)
-    (f : (V d →ₗ[F] W n) → Complex)
-    (T₀ : V d →ₗ[F] W n) :
-    (NestedDomain A₂ A₁ →ₗ[F] NestedCodomain B₁ B₂) → Complex :=
-  fun N => f (T₀ + B₂.subtype.comp
-    ((0 + (B₁.comap B₂.subtype).subtype.comp
