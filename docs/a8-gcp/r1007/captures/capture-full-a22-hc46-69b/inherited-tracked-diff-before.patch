-private theorem linePeelLoss_nonneg (r k : Nat) : 0 <= linePeelLoss r k := by
-  induction k with
-  | zero => simp [linePeelLoss]
-  | succ k ih =>
-      simp only [linePeelLoss]
-      exact mul_nonneg (by positivity) ih
