-/-- Typed one-dimensional line selection is preserved by an actual carrier
-reindexing.  The characterization by `Selected L ⊤` handles the unique
-nonzero generator over `ZMod 2` without choosing a new line witness. -/
-theorem typedLineSelected_reindex_mapped {n d n' d' : Nat}
-    {A : Submodule F (V d)} {A' : Submodule F (V d')}
-    (B : Submodule F (W n)) (B' : Submodule F (W n'))
-    (L : Submodule F (V d ⧸ A)) (hL : Module.finrank F L = 1)
-    (eD : (V d' ⧸ A') ≃ₗ[F] (V d ⧸ A))
-    (eB : B' ≃ₗ[F] B)
-    (Y : B →ₗ[F] (V d ⧸ A)) :
-    typedLineSelected B' (L.map eD.symm.toLinearMap)
-      ((eD.symm.finrank_map_eq L).trans hL)
-      (frequencyReindexEquiv eD eB Y) ↔ typedLineSelected B L hL Y := by
-  rw [typedLineSelected_iff_Selected, typedLineSelected_iff_Selected]
-  simpa using selected_reindex_mapped eD eB L (⊤ : Submodule F B) Y
