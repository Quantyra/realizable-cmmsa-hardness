-theorem append_rank_projection_energy_le {n c s i : Nat}
-    (hi : i ≤ c + s)
-    (F : BinaryMatrix n (c + s) → Real)
-    (basisInv : ∀ (M : BinaryMatrix n (c + s))
-      (U V : BinaryMatrix (c + s) (c + s)),
