-      simpa [φMap] using hz
-    · intro y
-      refine ⟨⟨y.1.comp eD.symm.toLinearMap, ?_⟩, ?_⟩
-      · simpa using y.2
-      · apply Subtype.ext
-        apply LinearMap.ext
-        intro z
