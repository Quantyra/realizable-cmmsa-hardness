-          ∑ A : MatrixImageFibre n (c + s) i E.1,
-            (fourierCoeff (rankProjection i F) A.1) ^ 2 := by
-      apply Finset.sum_le_sum
-      intro E hE
-      exact per_image_energy_ratio E.1 E.2 hi F basisInv
