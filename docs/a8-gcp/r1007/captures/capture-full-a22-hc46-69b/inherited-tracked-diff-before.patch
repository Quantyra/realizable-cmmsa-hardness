-      exact ⟨⟨A.1, A.2.1⟩, hzero⟩
-    · intro Z
-      apply Subtype.ext
-      apply Subtype.ext
-      rfl
-    · intro p
-      apply Sigma.ext
-      · apply Subtype.ext
-        exact p.2.1.2.2.symm
-      · apply Subtype.ext
-        rfl
-  have hsum :
-      (∑ Z : RankMatrixType n (c + s) i,
