-      (2 : Real) ^ (-((i : Real) * (s : Real))) *
-        ∑ A : MatrixImageFibre n (c + s) i E,
-          (fourierCoeff (rankProjection i F) A.1) ^ 2 := by
-  classical
-  letI : IsEmpty (RetainedMatrixImageFibre (c := c) (s := s) E hE) :=
