-/-- The exact A15 loss for removing `k` domain coordinates and then `l`
-codomain coordinates from a matrix-valued function. -/
-def mixedCoordinatePeelLoss (r k l : Nat) : Real :=
-  hyperplanePeelLoss r l * linePeelLoss (r + l) k
