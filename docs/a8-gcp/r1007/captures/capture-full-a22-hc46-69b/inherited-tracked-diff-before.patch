-/-- The complete common mixed operator is linear in the initial complex
-function. -/
-theorem commonMixedDerivativeChain_add {n d k l : Nat}
-    (f g : BinaryMatrix (n + l) (d + k) -> Complex)
-    (tLine : Fin k -> Fin (n + l) -> ZMod 2)
