-theorem frequencyReindex_rank {D D' C C' : Type*}
-    [AddCommGroup D] [Module F D] [AddCommGroup D'] [Module F D']
-    [AddCommGroup C] [Module F C] [AddCommGroup C'] [Module F C']
-    (eD : D' ≃ₗ[F] D) (eC : C' ≃ₗ[F] C)
-    (Y : C →ₗ[F] D) :
-    Module.finrank F (LinearMap.range (frequencyReindexEquiv eD eC Y)) =
-      Module.finrank F (LinearMap.range Y) := by
-  have hpre :
-      LinearMap.range (Y.comp eC.toLinearMap) = LinearMap.range Y := by
-    rw [LinearMap.range_comp]
-    simp
-  change Module.finrank F
-      (LinearMap.range
-        (eD.symm.toLinearMap.comp (Y.comp eC.toLinearMap))) = _
-  rw [LinearMap.range_comp, hpre]
-  exact eD.symm.finrank_map_eq (LinearMap.range Y)
-
-/-- The manuscript hybrid-selection predicate is invariant under simultaneous
-linear reindexing of domain, codomain, and the selected subspaces.  This is the
-range-membership bridge needed to transport a selected carrier filter; it does
-not assume a selected-frequency correspondence. -/
-theorem selected_reindex_mapped {D D' C C' : Type*}
-    [AddCommGroup D] [Module F D] [AddCommGroup D'] [Module F D']
-    [AddCommGroup C] [Module F C] [AddCommGroup C'] [Module F C']
-    (eD : D' ≃ₗ[F] D) (eC : C' ≃ₗ[F] C)
-    (A : Submodule F D) (B : Submodule F C)
-    (Y : C →ₗ[F] D) :
-    Selected (A.map eD.symm.toLinearMap) (B.map eC.symm.toLinearMap)
-      (frequencyReindexEquiv eD eC Y) ↔ Selected A B Y := by
-  constructor
-  · rintro ⟨hrange, hpre⟩
-    constructor
-    · intro a ha
-      have hmap : eD.symm a ∈ A.map eD.symm.toLinearMap :=
-        Submodule.mem_map.mpr ⟨a, ha, rfl⟩
-      rcases LinearMap.mem_range.mp (hrange hmap) with ⟨x, hx⟩
-      refine LinearMap.mem_range.mpr ⟨eC x, ?_⟩
-      simpa [frequencyReindexEquiv] using congrArg eD hx
-    · intro x hx
-      have hmap : frequencyReindexEquiv eD eC Y (eC.symm x) ∈
-          A.map eD.symm.toLinearMap := by
-        simpa [frequencyReindexEquiv] using
-          (Submodule.mem_map.mpr ⟨Y x, hx, rfl⟩ :
-            eD.symm (Y x) ∈ A.map eD.symm.toLinearMap)
-      have hpre' := hpre (eC.symm x) hmap
-      rcases Submodule.mem_map.mp hpre' with ⟨y, hy, hyx⟩
-      have : y = x := eC.symm.injective (by simpa using hyx)
-      simpa [this] using hy
-  · rintro ⟨hrange, hpre⟩
-    constructor
-    · intro a' ha'
-      rcases Submodule.mem_map.mp ha' with ⟨a, ha, haa'⟩
-      rcases LinearMap.mem_range.mp (hrange ha) with ⟨x, hx⟩
-      refine LinearMap.mem_range.mpr ⟨eC.symm x, ?_⟩
-      change eD.symm (Y (eC (eC.symm x))) = a'
-      calc
-        eD.symm (Y (eC (eC.symm x))) = eD.symm a := by
-          simp only [eC.apply_symm_apply]
-          exact congrArg eD.symm hx
-        _ = a' := haa'
-    · intro x' hx'
-      rcases Submodule.mem_map.mp hx' with ⟨a, ha, hEq⟩
-      have hEq' : a = Y (eC x') := by
-        simpa [frequencyReindexEquiv] using congrArg eD hEq
-      have hA : Y (eC x') ∈ A := by
-        rw [← hEq']
-        exact ha
-      have hB := hpre (eC x') hA
-      exact Submodule.mem_map.mpr ⟨eC x', hB, eC.symm_apply_apply x'⟩
