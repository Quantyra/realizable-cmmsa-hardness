-    {Z : RankMatrixType n (c + s) i // appendedFrequencyPart Z.1 = 0}
-  let Fibred : Type :=
-    Σ E : RankImageSubspaces n i,
-      RetainedMatrixImageFibre (c := c) (s := s) E.1 E.2
