-  · intro x hx
-    rcases Submodule.mem_map.mp hx with ⟨y, hy, rfl⟩
-    rcases Submodule.mem_map.mp hy with ⟨z, hz, hzy⟩
-    rw [← hzy]
-    simpa using hz
