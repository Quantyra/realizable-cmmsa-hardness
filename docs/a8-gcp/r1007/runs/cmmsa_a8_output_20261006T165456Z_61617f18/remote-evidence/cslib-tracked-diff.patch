-/-- An β-reduction step does not introduce new free variables. -/
-lemma step_not_fv (step : M ⭢βᶠ N) : N.fv ⊆ M.fv := by
-  induction step with
-  | base h => cases h with | beta => grind [open_preserve_not_fvar]
-  | @abs M N =>
-    have ⟨x, _⟩ := fresh_exists <| free_union [fv] Var
