+  flts.toLTS.Tr s1 μ s2 ↔ flts.tr s1 μ = s2 := by rfl
+
+/-- The transition system of a FLTS is deterministic. -/
+@[scoped grind ⇒]
+instance toLTS_deterministic (flts : FLTS State Label) : flts.toLTS.Deterministic := by
+  open LTS in grind
