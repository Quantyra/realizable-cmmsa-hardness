+name: Lean Action CI
+
+on:
+  push:
+    branches:
+      - main
+      - nightly-testing
+  pull_request:
+  merge_group:
+  workflow_dispatch:
+
+jobs:
+  ci-checks:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: Set TEST_ARGS manually
+        run: |
+          echo "TEST_ARGS='--wfail --iofail'" >> $GITHUB_ENV
+        shell: bash
+      - uses: leanprover/lean-action@v1
+        with:
