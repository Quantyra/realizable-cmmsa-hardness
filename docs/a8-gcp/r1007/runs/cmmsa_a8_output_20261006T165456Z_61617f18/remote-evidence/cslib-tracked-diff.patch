+inductive Xi (R : Term Var → Term Var → Prop) : Term Var → Term Var → Prop
+/-- The base relation. -/
+| base : R M N → Xi R M N
+/-- Left congruence rule for application. -/
+| appL: LC Z → Xi R M N → Xi R (app Z M) (app Z N)
+/-- Right congruence rule for application. -/
