+    to f in left-associative order, i.e. as (((f x₁) x₂) ... xₙ). -/
+@[simp, scoped grind =]
+def multiApp (f : Term Var) : List (Term Var) → Term Var
+| []      => f
+| a :: as => multiApp (app f a) as
