-/-- Convenience definition for rewriting conclusions in proofs. -/
-@[scoped grind =]
-def Proof.rwConclusion {Γ Δ : Sequent Atom} (h : Γ = Δ) (p : ⇓Γ) := InferenceSystem.rwConclusion h p
