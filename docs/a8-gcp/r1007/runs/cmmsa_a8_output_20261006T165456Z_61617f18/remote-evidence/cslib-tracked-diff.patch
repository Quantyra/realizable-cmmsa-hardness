+/-! Multiple substitution for untyped lambda calculus. -/
+
+@[expose] public section
+
+namespace Cslib
+
+universe u v
+
+
+namespace LambdaCalculus.LocallyNameless.Untyped.Term
+
+open scoped Context
+
+variable {Var : Type u} {Base : Type v} [DecidableEq Var]
