+theorem map_append_ωSequence (f : α → β) :
+    ∀ (l : List α) (s : ωSequence α), map f (l ++ω s) = List.map f l ++ω map f s
+  | [], _ => rfl
+  | List.cons a l, s => by
+    rw [cons_append_ωSequence, List.map_cons, map_cons,
+      cons_append_ωSequence, map_append_ωSequence f l]
