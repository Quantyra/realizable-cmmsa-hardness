+instance [Inhabited α] : Inhabited (ωSequence α) :=
+  ⟨ωSequence.const default⟩
+
+instance [h : IsEmpty α] : IsEmpty (ωSequence α) where
+  false xs := IsEmpty.false (xs 0)
