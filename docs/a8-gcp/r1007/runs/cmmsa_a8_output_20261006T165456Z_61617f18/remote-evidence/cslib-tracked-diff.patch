+the Lean modal model induced by `r`. -/
+theorem Proposition.equivOfPredicates_and {r : α → α → Prop} {P Q : α → Prop} :
+    (fun a => P a ∧ Q a) ≡[Equiv.OfPredicates r] (P ∧ Q) := by grind
