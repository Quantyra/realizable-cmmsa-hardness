-/-- & is idempotent. -/
-@[scoped grind ←]
-def withIdem {a : Proposition Atom} : a & a ≡⇓ a :=
-  ⟨.oplus₁ .ax',
-   show ({a⫠, a & a} : Sequent Atom) = {a & a, a⫠} by grind ▸ .with .ax .ax⟩
