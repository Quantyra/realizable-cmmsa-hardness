+namespace CslibTests
+
+open Cslib.Automata
+
+/-! A simple elevator. -/
+
+inductive Floor where
+| one
+| two
+deriving DecidableEq
+
+inductive Direction where
+| up
+| down
+deriving DecidableEq
+
+def elevator : DA Floor Direction where
+  tr
