-| fvar x => fvar x
-| abs σ t₁ => abs (σ[X := δ]) (substTy X δ t₁)
-| app t₁ t₂ => app (substTy X δ t₁) (substTy X δ t₂)
-| tabs σ t₁ => tabs (σ[X := δ]) (substTy X δ t₁)
-| tapp t₁ σ => tapp (substTy X δ t₁) (σ[X := δ])
-| let' t₁ t₂ => let' (substTy X δ t₁) (substTy X δ t₂)
-| inl t₁ => inl (substTy X δ t₁)
