-variable [HasFresh Var] [DecidableEq Var]
-
-/-- The right side of a reduction is locally closed. -/
-@[scoped grind →]
-lemma step_lc_r (step : M ⭢βᶠ M') : LC M' := Xi.step_lc_r (by grind) step
