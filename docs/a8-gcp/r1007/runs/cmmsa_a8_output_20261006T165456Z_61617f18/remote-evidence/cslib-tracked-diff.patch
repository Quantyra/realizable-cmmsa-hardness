-lemma openRecTy_lc {t : Term Var} (lc : t.LC) : t = t⟦X ↝ σ⟧ᵗᵞ := by
-  induction lc generalizing X with
-  | let' | case | tabs | abs =>
-    grind [fresh_exists <| free_union Var, Ty.openRec_lc, openRecTy_neq_eq]
-  | _ => grind [Ty.openRec_lc]
