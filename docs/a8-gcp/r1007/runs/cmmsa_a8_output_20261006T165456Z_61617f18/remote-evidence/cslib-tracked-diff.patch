-  induction μs generalizing s s' with
-  | nil =>
-    simp [eq_comm]
-  | cons x xs ih =>
-    simp_rw [List.reverse_cons, MTr.append_iff, MTr.singleton_iff, MTr.cons_iff, and_comm, ih,
