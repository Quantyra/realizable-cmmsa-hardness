-/-- ⊕ is idempotent. -/
-@[scoped grind ←]
-def oplusIdem {a : Proposition Atom} : a ⊕ a ≡⇓ a :=
-  ⟨.with .ax' .ax',
-   show ({a⫠, a ⊕ a} : Sequent Atom) = {a ⊕ a, a⫠} by grind ▸ .oplus₁ .ax⟩
