-def BuchiCongruence (na : Buchi State Symbol) : RightCongruence Symbol where
-  eq.r u v :=
-    ∀ s t, (u ∈ na.pairLang s t ↔ v ∈ na.pairLang s t) ∧
-      (u ∈ na.pairViaLang na.accept s t ↔ v ∈ na.pairViaLang na.accept s t)
