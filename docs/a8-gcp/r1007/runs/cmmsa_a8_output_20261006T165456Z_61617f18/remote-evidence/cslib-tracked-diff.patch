-example : (ʔ0 : P) ≡⇓ ⊥ := Proposition.questZeroEqvBot
-example : (a ⊗ b : P) ≡⇓ b ⊗ a := Proposition.tensorSymm
-example : (a ⊗ (b ⊗ c) : P) ≡⇓ (a ⊗ b) ⊗ c := Proposition.tensorAssoc
