-theorem Total.omegaExecution_exists [h : lts.Total] (s : State) (μs : ωSequence Label) :
-    ∃ ss, lts.OmegaExecution ss μs ∧ ss 0 = s := by
-  use lts.chooseOmegaExecution s μs
-  grind [chooseOmegaExecution, Total.chooseFLTS]
