info: lean/PvNP/RealizableHardness/ActualFiniteAppendExactImageEnergyChecks.lean:3:0: PvNP.RealizableHardness.ActualFiniteAppendExactImageEnergy.append_rank_projection_energy_eq_frame_ratio {n c s i : ℕ}
  (hi : i ≤ c + s) (F : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n (c + s) → ℝ)
  (basisInv :
    ∀ (M : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix n (c + s))
      (U V : PvNP.RealizableHardness.BinaryMatrixFourier.BinaryMatrix (c + s) (c + s)),
      U * V = 1 → V * U = 1 → F (M * U) = F M) :
  (PvNP.RealizableHardness.BinaryMatrixFourier.uniformMean fun M =>
      PvNP.RealizableHardness.ActualFixedFunctionalAppendOperator.appendAverage
          (PvNP.RealizableHardness.BinaryMatrixFourier.rankProjection i F) M ^
        2) =
    ↑(PvNP.RealizableHardness.GrassmannCounting.frameProduct c i) /
        ↑(PvNP.RealizableHardness.GrassmannCounting.frameProduct (c + s) i) *
      PvNP.RealizableHardness.BinaryMatrixFourier.uniformMean fun W =>
        PvNP.RealizableHardness.BinaryMatrixFourier.rankProjection i F W ^ 2
