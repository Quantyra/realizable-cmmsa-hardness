info: lean/PvNP/RealizableHardness/ActualSelectedComplementSourceSizeSpectralApplicationChecks.lean:3:0: PvNP.RealizableHardness.ActualSelectedComplementSourceSizeSpectralApplication.selected_actual_material_moment_bound_original_spectral_discharged
  {N rows m L samplerA : ℕ} (I : PvNP.RealizableHardness.ActualOccurrenceAllocation.Instance N rows) (copies : ℕ)
  (U :
    PvNP.RealizableHardness.ActualTaggedConcreteStarLaw.TaggedGoodU I copies
      (PvNP.RealizableHardness.SamplerParameters.blocks samplerA
        (PvNP.RealizableHardness.ActualCmmsaParameterReconciliation.hBlock L m)))
  (A : PvNP.RealizableHardness.ActualTaggedComplementIncidence.SideComplement I copies U)
  (C : PvNP.RealizableHardness.ActualTaggedFixedTableAcceptance.TaggedCenterTable I copies)
  (T : PvNP.RealizableHardness.ActualTaggedFixedTableAcceptance.TaggedLeafTable I copies) (f : Module.Dual (ZMod 2) ↥↑A)
  (base : ℕ → ℕ) (sourceHeightCutoff : ℝ → ℕ)
  (hsel :
    PvNP.RealizableHardness.ActualCmmsaAdmissibilitySelector.selector
        (fun j =>
          max
            (PvNP.RealizableHardness.ActualSelectedSpectralParameters.analyticSourceHeightFloor base sourceHeightCutoff
              j)
            (j + 2))
        L =
      ↑m)
  (hA : 1 ≤ samplerA) (r : ℕ)
  (hrd :
    r <
      PvNP.RealizableHardness.ActualStarFixedRhoDimensionGuard.leafT m
          (PvNP.RealizableHardness.ActualCmmsaParameterReconciliation.hBlock L m) +
        PvNP.RealizableHardness.ActualStarFixedRhoDimensionGuard.leafK m
          (PvNP.RealizableHardness.ActualCmmsaParameterReconciliation.hBlock L m))
  (e : ℚ) (he : 0 ≤ e)
  (hfail :
    ∀ (q : ℕ)
      (Q :
        PvNP.RealizableHardness.GrassmannCounting.Grass
          (PvNP.RealizableHardness.ActualComplementCoordinateMassBridge.CoordAmbient
            (PvNP.RealizableHardness.SamplerParameters.blocks samplerA
              (PvNP.RealizableHardness.ActualCmmsaParameterReconciliation.hBlock L m)))
          q)
      (P :
        PvNP.RealizableHardness.ActualMaximalPairLadder.DecodedPair Q
          (PvNP.RealizableHardness.ActualStarFixedRhoDimensionGuard.leafT m
              (PvNP.RealizableHardness.ActualCmmsaParameterReconciliation.hBlock L m) +
            PvNP.RealizableHardness.ActualStarFixedRhoDimensionGuard.leafK m
              (PvNP.RealizableHardness.ActualCmmsaParameterReconciliation.hBlock L m))),
      q + PvNP.RealizableHardness.ActualMaximalPairLadder.codim P.W = r →
        Fintype.card (PvNP.RealizableHardness.ActualMaximalPairLadder.Zoom Q P) ≠ 0 →
          PvNP.RealizableHardness.ActualMaximalPairLadder.agreement
              (fun X =>
                PvNP.RealizableHardness.ActualComplementCoordinateMassBridge.selectedCoordinateLeafTable I copies U A T
                  X)
              Q P ≤
            e)
  (a : ℝ) (ha : 0 < a) :
  let h := PvNP.RealizableHardness.ActualCmmsaParameterReconciliation.hBlock L m;
  let J := PvNP.RealizableHardness.SamplerParameters.blocks samplerA h;
  let c := PvNP.RealizableHardness.ActualStarFixedRhoDimensionGuard.leafT m h;
  let s := PvNP.RealizableHardness.ActualStarFixedRhoDimensionGuard.leafK m h;
  let n := 2 * J;
  have Cc := PvNP.RealizableHardness.ActualComplementCoordinateMassBridge.selectedCoordinateCenterTable I copies U A C;
  have Tc := PvNP.RealizableHardness.ActualComplementCoordinateMassBridge.selectedCoordinateLeafTable I copies U A T;
  have fc := PvNP.RealizableHardness.ActualComplementCoordinateMassBridge.coordinateFunctional I copies U A f;
  ∃ k q,
    k = 2 ^ q ∧
      4 * m ≤ k ∧
        k < 8 * m ∧
          ↑(PvNP.RealizableHardness.ActualOrdinaryStarWeightedSelection.matchingStarMass ⋯ ⋯
                  (PvNP.RealizableHardness.ActualTaggedComplementStarDensityBridge.transportedCenterTable I copies U A
                    C)
                  (PvNP.RealizableHardness.ActualTaggedComplementStarDensityBridge.transportedLeafTable I copies U A T)
                  f) ≤
              2 *
                PvNP.RealizableHardness.ActualSelectedComplementSourceSizeAnalyticMoment.selected_actual_analytic_rhs Cc
                  Tc fc r k (2 * ↑e) a ∧
            ↑(PvNP.RealizableHardness.ActualOrdinaryStarWeightedSelection.matchingCenterMass ⋯ ⋯
                  (PvNP.RealizableHardness.ActualTaggedComplementStarDensityBridge.transportedCenterTable I copies U A
                    C)
                  f) =
              (∑ R,
                  if PvNP.RealizableHardness.ActualFixedFunctionalStarMoment.centerMatchBit Cc fc R = true then 1
                  else 0) /
                ↑(Fintype.card
                    (PvNP.RealizableHardness.GrassmannCounting.Grass
                      (PvNP.RealizableHardness.ActualComplementCoordinateMassBridge.CoordAmbient J) c))
