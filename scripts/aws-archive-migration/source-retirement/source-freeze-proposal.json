{
  "type": "archive-source-freeze-proposal-v1",
  "apply_authorized": false,
  "source_bucket": "quantyra-research-archive-485386182336-us-east-1",
  "root_retirement_principal": null,
  "existing_policy_must_be_preserved": true,
  "statements_to_merge_after_root_review": [
    {
      "Sid": "ArchiveProducerFreezeProposal",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutObjectTagging",
        "s3:DeleteObjectTagging",
        "s3:PutObjectVersionTagging",
        "s3:DeleteObjectVersionTagging",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl",
        "s3:PutObjectRetention",
        "s3:PutObjectLegalHold",
        "s3:RestoreObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::quantyra-research-archive-485386182336-us-east-1/*"
      ],
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": "UNRESOLVED_DISTINCT_ROOT_ACCEPTED_EXECUTOR"
        }
      }
    }
  ],
  "read_access_preserved": [
    "s3:GetObject",
    "s3:GetObjectVersion",
    "s3:GetObjectVersionTagging",
    "s3:GetObjectAcl",
    "s3:ListBucket",
    "s3:ListBucketVersions"
  ],
  "no_shared_principal_revocation": true,
  "requirements": [
    "Stop and prove all local/remote archive producers and schedulers",
    "Inventory whole namespace, markers and multipart uploads before and after freeze",
    "Prevent competing bucket policy/lifecycle/replication/control writes through accepted exclusive custody",
    "Accept dedicated executor exception and exact resulting policy independently",
    "Preserve source Get/read and key/catalog custody until deletion eligibility",
    "Maintain destination exact-version retention through execution and final independent checks"
  ]
}
